# Shopify (managed by Shopify CLI / Partners)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=

# PostgreSQL invoice store
DATABASE_URL=postgresql://postgres:root@localhost:5432/invoice

# ERP ingest authentication
INVOICE_INGEST_SECRET=change-me-to-a-long-random-secret
INVOICE_SHOP_DOMAIN=your-store.myshopify.com

# Optional static company block on generated invoices
INVOICE_COMPANY_NAME=INK QUEST
INVOICE_STREET_ADDRESS1=14617 134 Ave NW
INVOICE_STREET_ADDRESS2=Edmonton, AB T5L 4S9
INVOICE_TELEPHONE=(780) 454-4321
INVOICE_FAX=(780) 452-5405
INVOICE_TAX_REGISTRATION_NO=
INVOICE_LOGO_URL=

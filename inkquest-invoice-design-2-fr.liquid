{% comment %}
  ============================================================================
  INK QUEST INVOICE — DESIGN 2, FRENCH (modèle français)
  Same design as the English New Invoice Design 2 (dark-teal header band,
  sold-to/ship-to boxes, 7-column order strip, teal items table, tax
  summary + green amount-due bar), with all labels in French.
  Ready-to-use Shopify Liquid template. Drop into the theme wherever
  invoices render (e.g. a page template or the customer account invoices
  section) and wire the `invoice` object described below.

  VARIABLE MAP (Sage invoice -> Liquid — same object as Design 1):
    invoice.number            e.g. "IN01069154"
    invoice.date              e.g. "13 oct. 2026"
    invoice.customer_no       e.g. "3040"
    invoice.order_date        e.g. "21 sept. 2026"
    invoice.order_no          e.g. "ORD0887678"
    invoice.salesperson       e.g. "ABSALES"
    invoice.po_number         e.g. "PO611."
    invoice.ship_via          e.g. "CANPAR"
    invoice.terms             e.g. "N30"
    invoice.sold_to           { name, addr1, city, province, postal, country }
    invoice.ship_to           { name, addr1, city, province, postal, country }
    invoice.lines[]           { qty_ord, qty_shp, bo, item_number,
                                description, unit_price, uom, extended_price }
    invoice.gst               e.g. 449.13
    invoice.pst               e.g. 0.00
    invoice.tax_exempt_code   e.g. "2618718"
    invoice.subtotal          e.g. 8982.65
    invoice.total_tax         e.g. 449.13
    invoice.total_amount      e.g. 9431.78
    invoice.less_payment      e.g. 0.00
    invoice.amount_due        e.g. 9431.78

  NOTES:
  - Money uses | money_without_currency so the shop's French locale
    renders "8 982,65" (no $ sign), matching Design 2's number-only style.
  - Product descriptions and customer names/addresses come from the data
    as-is (catalog titles stay in English, as on the English invoice).
  - PAGINATION: fully dynamic — 18 lines per page (change
    `lines_per_page` below to adjust). Page 1 gets the full header band;
    every later page gets the slim "Suite" band. Page labels read
    "Page X de Y"; the totals section renders on the last page only.
  ============================================================================
{% endcomment %}

{% assign lines_per_page = 18 %}
{% assign total_pages = invoice.lines.size | plus: lines_per_page | minus: 1 | divided_by: lines_per_page %}
{% if total_pages < 1 %}{% assign total_pages = 1 %}{% endif %}

{% capture totals_block %}
<div class="iq-bottom">
  <div class="iq-left">
    <div class="iq-gst">Nº de TPS/TVH : 139587877</div>
    <p>Aucun retour sans notre autorisation écrite (RMA).</p>
    <p>Des frais de 2 % par mois (24 % par année) seront facturés sur les comptes en souffrance.</p>
    <p>Toute réclamation doit être faite dans les 5 jours suivant la réception des marchandises.</p>
    <p>Des frais de 3 % peuvent s'appliquer à tout paiement par carte de crédit.</p>
    <div class="iq-pm">
      <h3>MODES DE PAIEMENT</h3>
      <h4>Virement/TÉF</h4>
      <p>Numéro d'institution : 003</p>
      <p>Transit : 07378</p>
      <p>Numéro de compte : 1027812</p>
      <div class="iq-pm-sub">
        <h4>Paiement de facture</h4>
        <p>Ink Quest</p>
      </div>
    </div>
  </div>
  <div class="iq-right">
    <div class="iq-taxbox">
      <h3>SOMMAIRE DES TAXES</h3>
      <div class="iq-trow"><span>TPS</span><span>{{ invoice.gst | money_without_currency }}</span></div>
      <div class="iq-trow"><span>TVP SK</span><span>{{ invoice.pst | money_without_currency }}</span></div>
      <div class="iq-trow"><span>Code d'exemption de taxe</span><span>{{ invoice.tax_exempt_code }}</span></div>
    </div>
    <div class="iq-trow"><span>Sous-total</span><span>{{ invoice.subtotal | money_without_currency }}</span></div>
    <div class="iq-trow"><span>Total des taxes de vente</span><span>{{ invoice.total_tax | money_without_currency }}</span></div>
    <div class="iq-trow"><span>Montant total</span><span>{{ invoice.total_amount | money_without_currency }}</span></div>
    <div class="iq-trow"><span>Moins paiement</span><span>{{ invoice.less_payment | money_without_currency }}</span></div>
    <div class="iq-due"><span>Montant dû</span><span>{{ invoice.amount_due | money_without_currency }}</span></div>
  </div>
</div>
{% endcapture %}

{% capture items_table_head %}
<tr>
  <th class="c">Qté<br>comm.</th><th class="c">Qté<br>exp.</th><th class="c">En<br>att.</th>
  <th>Nº d'article</th><th>Description</th>
  <th class="r">Prix<br>unitaire</th><th class="c">Unité</th><th class="r">Prix<br>étendu</th>
</tr>
{% endcapture %}

<style>
  .iq-fr-logo{display:block;width:160px;max-width:100%;height:auto;max-height:64px;object-fit:contain;background:#fff;padding:6px;}.iq-band-slim .iq-fr-logo{width:120px;max-height:44px;}
  .iq-invoice { font-family: 'Poppins', 'Helvetica Neue', Arial, sans-serif; color: #1c2b33; max-width: 8.5in; margin: 0 auto; }
  .iq-invoice * { box-sizing: border-box; }
  .iq-page { width: 8.5in; min-height: 11in; padding: 0.35in 0.55in 0.3in; position: relative; background: #fff; }
  /* Header band (dark teal) */
  .iq-band { background: #00404c; color: #fff; display: flex; justify-content: space-between;
             align-items: flex-start; padding: 12px 24px; }
  .iq-band .iq-brand { font-size: 20px; font-weight: 700; letter-spacing: 5px; }
  .iq-band .iq-brand small { display: block; font-size: 10px; font-weight: 400; letter-spacing: 0.5px; margin-top: 6px; }
  .iq-band .iq-co { font-size: 10px; line-height: 1.6; margin-top: 6px; }
  .iq-band .iq-invtitle { text-align: right; }
  .iq-band .iq-invtitle h1 { font-size: 26px; font-weight: 700; margin: 0 0 8px; letter-spacing: 1px; }
  .iq-band .iq-invtitle p { font-size: 11px; margin: 0; line-height: 1.6; }
  /* Slim continued band (later pages) */
  .iq-band-slim { background: #00404c; color: #fff; display: flex; justify-content: space-between;
                  align-items: center; padding: 12px 24px; }
  .iq-band-slim .iq-brand { font-size: 15px; font-weight: 700; letter-spacing: 4px; }
  .iq-band-slim p { font-size: 12px; margin: 0; }
  /* Addresses */
  .iq-addr { display: flex; gap: 20px; margin-top: 12px; }
  .iq-addr > div { flex: 1; border: 1px solid #d9e0de; padding: 10px 16px; }
  .iq-lbl { font-size: 11px; font-weight: 700; letter-spacing: 0.5px; color: #00404c; margin-bottom: 5px; }
  .iq-addr p { font-size: 11.5px; line-height: 1.55; margin: 0; }
  .iq-addr p b { font-weight: 700; }
  /* Order meta strip */
  .iq-meta { display: flex; margin-top: 12px; border: 1px solid #d9e0de; }
  .iq-meta div { flex: 1; padding: 6px 8px; font-size: 11px; }
  .iq-meta span { display: block; font-size: 8.5px; font-weight: 600; letter-spacing: 0.2px; color: #5b6b72; margin-bottom: 4px; }
  /* Sample-data badge */
  .iq-badge { font-size: 10px; font-weight: 700; color: #8a6d00; margin: 10px 0 6px; letter-spacing: 0.3px; }
  /* Line items table */
  .iq-items { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 11px; }
  .iq-items th { background: #00404c; color: #fff; font-size: 10.5px; font-weight: 700;
                 padding: 6px 6px; text-align: left; vertical-align: middle; }
  .iq-items td { padding: 2px 4px; border-bottom: 1px solid #e6ebea; border-left: 1px solid #eef1f0;
                 vertical-align: top; font-size: 10.5px; line-height: 1.25; overflow-wrap: break-word; }
  .iq-items td:first-child { border-left: none; }
  .iq-items .c { text-align: center; } .iq-items .r { text-align: right; }
  .iq-cont { text-align: center; font-size: 12.5px; font-weight: 700; color: #00404c; padding-top: 10px; }
  /* Bottom two-column section */
  .iq-bottom { display: flex; gap: 22px; margin-top: 16px; }
  .iq-left { flex: 1.15; font-size: 12px; }
  .iq-gst { font-size: 12.5px; font-weight: 700; color: #00404c; margin-bottom: 8px; }
  .iq-left p { margin: 0 0 5px; line-height: 1.5; }
  .iq-pm { border-top: 1px solid #d9e0de; margin-top: 16px; padding-top: 12px; }
  .iq-pm h3 { font-size: 11px; font-weight: 700; color: #00404c; letter-spacing: 0.5px; margin: 0 0 8px; }
  .iq-pm h4 { font-size: 11px; font-weight: 700; margin: 8px 0 4px; }
  .iq-pm-sub { border-top: 1px dashed #d9e0de; margin-top: 10px; padding-top: 10px; }
  .iq-right { flex: 1; }
  .iq-taxbox { background: #f2f5f4; padding: 12px 16px 16px; margin-bottom: 14px; }
  .iq-taxbox h3 { font-size: 11px; font-weight: 700; letter-spacing: 0.5px; color: #00404c; margin: 0 0 8px; }
  .iq-trow { display: flex; justify-content: space-between; font-size: 12px; padding: 5px 0; }
  .iq-due { background: #2ea05f; color: #fff; display: flex;
            justify-content: space-between; align-items: center;
            padding: 12px 16px; margin-top: 10px; font-size: 15px; font-weight: 700; }
  .iq-foot { text-align: center; font-size: 11px; color: #5b6b72;
             border-top: 1px solid #d9e0de; padding-top: 10px; margin-top: 16px; }
  @media print {
    @page { size: letter; margin: 0; }
    .iq-page { page-break-after: always; }
    .iq-page:last-child { page-break-after: auto; }
  }
</style>

<div class="iq-invoice">

{% for page_num in (1..total_pages) %}
  {% assign start = forloop.index0 | times: lines_per_page %}
  {% assign page_lines = invoice.lines | slice: start, lines_per_page %}

  <section class="iq-page">
    {% if forloop.first %}
    <div class="iq-band">
      <div>
        <div class="iq-brand"><img class="iq-fr-logo" src="{{ 'inkquest-invoice-logo.svg' | asset_url }}" alt="Ink Quest"><small>(DIV. DE 605494 ALBERTA LTD)</small></div>
        <div class="iq-co">14617 - 134 Ave NW, Edmonton, AB T5L 4S9<br>
          Tél. : (780) 454-4321 &nbsp;&bull;&nbsp; Téléc. : (780) 452-5405</div>
      </div>
      <div class="iq-invtitle">
        <h1>FACTURE</h1>
        <p>Numéro de facture : {{ invoice.number }}<br>
          Date : {{ invoice.date }} &nbsp;&bull;&nbsp; Page {{ page_num }} de {{ total_pages }}</p>
      </div>
    </div>

    <div class="iq-addr">
      <div>
        <div class="iq-lbl">VENDU À</div>
        <p><b>{{ invoice.sold_to.name }}</b><br>
          {{ invoice.sold_to.addr1 }}<br>
          {{ invoice.sold_to.city }}, {{ invoice.sold_to.province }} {{ invoice.sold_to.postal }}<br>
          {{ invoice.sold_to.country }}</p>
      </div>
      <div>
        <div class="iq-lbl">EXPÉDIÉ À</div>
        <p><b>{{ invoice.ship_to.name }}</b><br>
          {{ invoice.ship_to.addr1 }}<br>
          {{ invoice.ship_to.city }}, {{ invoice.ship_to.province }} {{ invoice.ship_to.postal }}<br>
          {{ invoice.ship_to.country }}</p>
      </div>
    </div>

    <div class="iq-meta">
      <div style="flex:1.1"><span>Nº DE CLIENT</span>{{ invoice.customer_no }}</div>
      <div style="flex:1.3"><span>DATE DE COMMANDE</span>{{ invoice.order_date }}</div>
      <div style="flex:1.2"><span>Nº DE COMMANDE</span>{{ invoice.order_no }}</div>
      <div><span>VENDEUR</span>{{ invoice.salesperson }}</div>
      <div style="flex:1.3"><span>BON DE COMMANDE</span>{{ invoice.po_number }}</div>
      <div><span>EXPÉDIÉ PAR</span>{{ invoice.ship_via }}</div>
      <div><span>CONDITIONS</span>{{ invoice.terms }}</div>
    </div>
    {% else %}
    <div class="iq-band-slim">
      <div class="iq-brand"><img class="iq-fr-logo" src="{{ 'inkquest-invoice-logo.svg' | asset_url }}" alt="Ink Quest"></div>
      <p>Facture {{ invoice.number }} &mdash; Suite &nbsp;&bull;&nbsp; {{ invoice.date }} &nbsp;&bull;&nbsp; Page {{ page_num }} de {{ total_pages }}</p>
    </div>
    {% endif %}

    <div class="iq-badge">DONNÉES D'EXEMPLE &mdash; APERÇU DU MODÈLE</div>

    <table class="iq-items">
      <colgroup><col style="width:6.2%"><col style="width:6.2%"><col style="width:4.9%"><col style="width:13.3%"><col style="width:43.3%"><col style="width:9.8%"><col style="width:6.2%"><col style="width:10.1%"></colgroup>
      {{ items_table_head }}
      {% for line in page_lines %}
      <tr>
        <td class="c">{{ line.qty_ord }}</td>
        <td class="c">{{ line.qty_shp }}</td>
        <td class="c">{{ line.bo }}</td>
        <td>{{ line.item_number }}</td>
        <td>{{ line.description }}</td>
        <td class="r">{{ line.unit_price | money_without_currency }}</td>
        <td class="c">{{ line.uom }}</td>
        <td class="r">{{ line.extended_price | money_without_currency }}</td>
      </tr>
      {% endfor %}
    </table>

    {% if forloop.last %}
      {{ totals_block }}
    {% else %}
    <div class="iq-cont">Suite à la page suivante&hellip;</div>
    {% endif %}

    <div class="iq-foot">INK QUEST &nbsp;&bull;&nbsp; 14617 &ndash; 134 Ave NW, Edmonton, AB T5L 4S9</div>
  </section>

{% endfor %}

</div>

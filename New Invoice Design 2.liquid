{% comment %}
  ============================================================================
  INK QUEST INVOICE — DESIGN 1 (modern corporate)
  Ready-to-use Shopify Liquid template. Drop into the theme wherever invoices
  render (e.g. a page template or the customer account invoices section) and
  wire the `invoice` object described below.

  VARIABLE MAP (Sage invoice -> Liquid):
    invoice.number            e.g. "IN01069154"
    invoice.date              e.g. "Oct 13, 2026"
    invoice.customer_no       e.g. "3040"
    invoice.order_date        e.g. "Sep 21, 2026"
    invoice.order_no          e.g. "ORD0887678"
    invoice.salesperson       e.g. "ABSALES"
    invoice.po_number         e.g. "PO611."
    invoice.ship_via          e.g. "CANPAR"
    invoice.terms             e.g. "N30"
    invoice.sold_to           { name, addr1, city, province, postal, country }
    invoice.ship_to           { name, addr1, city, province, postal, country }
    invoice.lines[]           { qty_ord, qty_shp, bo, item_number,
                                description, unit_price, uom, extended_price }
    invoice.subtotal          e.g. 8982.65            (use | money as needed)
    invoice.gst               e.g. 449.13
    invoice.pst               e.g. 0.00
    invoice.tax_exempt_code   e.g. "2618718"
    invoice.total_tax         e.g. 449.13
    invoice.total_amount      e.g. 9431.78
    invoice.less_payment      e.g. 0.00
    invoice.amount_due        e.g. 9431.78

  PAGINATION: page 1 holds the first 18 lines; remaining lines go on page 2.
  Change `lines_per_page` below to adjust. Totals render on the last page only.
  ============================================================================
{% endcomment %}

{% assign lines_per_page = 18 %}
{% assign page1_lines = invoice.lines | slice: 0, lines_per_page %}
{% assign page2_lines = invoice.lines | slice: lines_per_page, invoice.lines.size %}
{% assign multi_page = false %}
{% if invoice.lines.size > lines_per_page %}{% assign multi_page = true %}{% endif %}

{% capture totals_block %}
<div class="iq-bottom">
  <div class="iq-left">
    <div class="iq-gst">GST/HST No.: 139587877</div>
    <p>No returns without our written permission (RMA).</p>
    <p>2% per month (24% annual) will be charged on overdue accounts.</p>
    <p>All claims must be made within 5 days after receipt of goods.</p>
    <p>A 3% charge may apply for any credit card bill payment.</p>
    <div class="iq-pm">
      <h3>PAYMENT METHODS</h3>
      <h4>Wire/EFT</h4>
      <p>Institution Number: 003</p>
      <p>Transit: 07378</p>
      <p>Account number: 1027812</p>
      <div class="iq-pm-sub">
        <h4>Bill Payment</h4>
        <p>Ink Quest</p>
      </div>
    </div>
  </div>
  <div class="iq-right">
    <div class="iq-taxbox">
      <h3>TAX SUMMARY</h3>
      <div class="iq-trow"><span>GST</span><span>{{ invoice.gst | money }}</span></div>
      <div class="iq-trow"><span>PSTSK</span><span>{{ invoice.pst | money }}</span></div>
      <div class="iq-trow"><span>Tax Exempt Code</span><span>{{ invoice.tax_exempt_code }}</span></div>
    </div>
    <div class="iq-trow"><span>Subtotal</span><span>{{ invoice.subtotal | money }}</span></div>
    <div class="iq-trow"><span>Total sales tax</span><span>{{ invoice.total_tax | money }}</span></div>
    <div class="iq-trow"><span>Total amount</span><span>{{ invoice.total_amount | money }}</span></div>
    <div class="iq-trow"><span>Less payment</span><span>{{ invoice.less_payment | money }}</span></div>
    <div class="iq-due"><span>Amount due</span><span>{{ invoice.amount_due | money }}</span></div>
  </div>
</div>
{% endcapture %}

{% capture items_table_head %}
<tr>
  <th class="c">Qty Ord.</th><th class="c">Qty Shp.</th><th class="c">B/O</th>
  <th>Item Number</th><th>Description</th>
  <th class="r">Unit Price</th><th class="c">UOM</th><th class="r">Extended Price</th>
</tr>
{% endcapture %}

<style>
  .iq-invoice { font-family: 'Poppins', sans-serif; color: #1c2b33; max-width: 8.5in; margin: 0 auto; }
  .iq-invoice * { box-sizing: border-box; }
  .iq-page { width: 8.5in; min-height: 11in; padding: 0.4in 0.55in; position: relative; background: #fff; }
  .iq-accent { display: flex; height: 4px; margin-bottom: 14px; }
  .iq-accent .t { flex: 0 0 80%; background: #074a53; }
  .iq-accent .g { flex: 1; background: #bad246; }
  /* Header (white, teal brand) */
  .iq-hdr { display: flex; justify-content: space-between; align-items: flex-start; }
  .iq-brand { font-size: 21px; font-weight: 700; letter-spacing: 6px; color: #074a53; }
  .iq-brand small { display: block; font-size: 10px; font-weight: 400; letter-spacing: 1px; color: #5b6b72; margin-top: 3px; }
  .iq-co { font-size: 11px; line-height: 1.55; margin-top: 8px; }
  .iq-invtitle { text-align: right; }
  .iq-invtitle .t { font-size: 10px; font-weight: 600; letter-spacing: 3px; color: #074a53; }
  .iq-invtitle h1 { font-size: 27px; font-weight: 700; margin: 2px 0 8px; }
  .iq-dpt { display: flex; gap: 18px; justify-content: flex-end; }
  .iq-dpt div { text-align: right; }
  .iq-dpt span { display: block; font-size: 9px; font-weight: 600; letter-spacing: 1px; color: #5b6b72; }
  .iq-dpt b { font-size: 12px; font-weight: 600; }
  .iq-contfrom { font-size: 11px; color: #5b6b72; text-align: right; margin-bottom: 4px; }
  /* Addresses */
  .iq-addr { display: flex; gap: 24px; margin-top: 16px; }
  .iq-addr > div { flex: 1; border: 1px solid #d9e0de; border-top: 4px solid #074a53;
                   border-radius: 0 0 8px 8px; padding: 10px 14px; }
  .iq-lbl { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; color: #074a53; margin-bottom: 5px; }
  .iq-addr p { font-size: 12.5px; line-height: 1.55; margin: 0; }
  /* Order meta strip (2 rows x 4) */
  .iq-meta { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 14px;
             border: 1px solid #d9e0de; border-radius: 8px; overflow: hidden; }
  .iq-meta div { padding: 8px 14px; font-size: 12px; border-left: 1px solid #d9e0de; }
  .iq-meta div:nth-child(4n+1) { border-left: none; }
  .iq-meta div:nth-child(n+5) { border-top: 1px solid #d9e0de; }
  .iq-meta span { display: block; font-size: 9px; font-weight: 600; letter-spacing: 1px; color: #5b6b72; }
  /* Compact meta strip (page 2) */
  .iq-meta1 { display: flex; margin-top: 14px; border: 1px solid #d9e0de;
              border-radius: 8px; padding: 10px 14px; font-size: 11.5px; }
  .iq-meta1 div { flex: 1; white-space: nowrap; }
  .iq-meta1 div:first-child { flex: 1.9; }
  .iq-meta1 b { font-weight: 600; }
  /* Line items label + badge */
  .iq-itemsbar { display: flex; justify-content: space-between; align-items: center; margin: 14px 0 8px; }
  .iq-itemsbar h3 { font-size: 14px; font-weight: 600; margin: 0; }
  .iq-badge { font-size: 10px; font-weight: 600; letter-spacing: 1.5px; color: #8a6d00;
              background: #fff3c4; border-radius: 4px; padding: 4px 12px; }
  /* Line items table */
  .iq-items { width: 100%; border-collapse: collapse; font-size: 12px; }
  .iq-items th { background: #074a53; color: #fff; font-size: 10px; font-weight: 600;
                 letter-spacing: .8px; padding: 8px 6px; text-align: left; }
  .iq-items td { padding: 9px 6px; border-bottom: 1px solid #e6ebea; vertical-align: top; font-size: 11.5px; }
  .iq-items .c { text-align: center; } .iq-items .r { text-align: right; }
  .iq-cont { text-align: center; font-size: 12px; font-weight: 600; color: #074a53; padding-top: 10px; }
  /* Bottom two-column section */
  .iq-bottom { display: flex; gap: 22px; margin-top: 16px; }
  .iq-left { flex: 1.25; font-size: 11.5px; }
  .iq-gst { font-size: 12px; font-weight: 600; color: #074a53; margin-bottom: 8px; }
  .iq-left p { margin: 0 0 5px; line-height: 1.5; }
  .iq-pm { border-top: 1px solid #d9e0de; margin-top: 14px; padding-top: 12px; }
  .iq-pm h3 { font-size: 12.5px; font-weight: 700; color: #074a53; letter-spacing: 1px; margin: 0 0 8px; }
  .iq-pm h4 { font-size: 11.5px; font-weight: 600; color: #074a53; margin: 8px 0 4px; }
  .iq-pm-sub { border-top: 1px dashed #d9e0de; margin-top: 8px; padding-top: 8px; }
  .iq-right { flex: 1; }
  .iq-taxbox { background: #f2f5f4; border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; }
  .iq-taxbox h3 { font-size: 10.5px; font-weight: 700; letter-spacing: 1.5px; color: #074a53; margin: 0 0 6px; }
  .iq-trow { display: flex; justify-content: space-between; font-size: 12.5px; padding: 4px 0; }
  .iq-due { background: #2ea05f; color: #fff; border-radius: 8px; display: flex;
            justify-content: space-between; align-items: center;
            padding: 10px 14px; margin-top: 8px; font-size: 14.5px; font-weight: 700; }
  .iq-foot { display: flex; justify-content: space-between; font-size: 10.5px; color: #5b6b72;
             border-top: 1px solid #d9e0de; padding-top: 8px; margin-top: 24px; }
  @media print {
    @page { size: letter; margin: 0; }
    .iq-page { page-break-after: always; }
    .iq-page:last-child { page-break-after: auto; }
  }
</style>

<div class="iq-invoice">

  <!-- ================= PAGE 1 ================= -->
  <section class="iq-page">
    <div class="iq-accent"><div class="t"></div><div class="g"></div></div>
    <div class="iq-hdr">
      <div>
        <div class="iq-brand">INK QUEST<small>(DIV. OF 605494 ALBERTA LTD)</small></div>
        <div class="iq-co">14617 - 134 Ave NW, Edmonton, AB T5L 4S9<br>
          Phone: (780) 454-4321 &nbsp;&nbsp; Fax: (780) 452-5405<br>
          GST/HST No.: 139587877</div>
      </div>
      <div class="iq-invtitle">
        <div class="t">INVOICE</div>
        <h1>{{ invoice.number }}</h1>
        <div class="iq-dpt">
          <div><span>DATE</span><b>{{ invoice.date }}</b></div>
          <div><span>PAGE</span><b>1 of {% if multi_page %}2{% else %}1{% endif %}</b></div>
          <div><span>TERMS</span><b>{{ invoice.terms }}</b></div>
        </div>
      </div>
    </div>

    <div class="iq-addr">
      <div>
        <div class="iq-lbl">SOLD TO</div>
        <p><b>{{ invoice.sold_to.name }}</b><br>
          {{ invoice.sold_to.addr1 }}<br>
          {{ invoice.sold_to.city }}, {{ invoice.sold_to.province }} {{ invoice.sold_to.postal }}<br>
          {{ invoice.sold_to.country }}</p>
      </div>
      <div>
        <div class="iq-lbl">SHIP TO</div>
        <p><b>{{ invoice.ship_to.name }}</b><br>
          {{ invoice.ship_to.addr1 }}<br>
          {{ invoice.ship_to.city }}, {{ invoice.ship_to.province }} {{ invoice.ship_to.postal }}<br>
          {{ invoice.ship_to.country }}</p>
      </div>
    </div>

    <div class="iq-meta">
      <div><span>CUSTOMER NO.</span>{{ invoice.customer_no }}</div>
      <div><span>ORDER DATE</span>{{ invoice.order_date }}</div>
      <div><span>ORDER NO.</span>{{ invoice.order_no }}</div>
      <div><span>SALESPERSON</span>{{ invoice.salesperson }}</div>
      <div><span>PO NUMBER</span>{{ invoice.po_number }}</div>
      <div><span>SHIP VIA</span>{{ invoice.ship_via }}</div>
      <div><span>TERMS</span>{{ invoice.terms }}</div>
      <div><span>GST/HST NO.</span>139587877</div>
    </div>

    <div class="iq-itemsbar">
      <h3>LINE ITEMS: 1 &ndash; {{ page1_lines.size }}</h3>
      <span class="iq-badge">SAMPLE DATA</span>
    </div>

    <table class="iq-items">
      {{ items_table_head }}
      {% for line in page1_lines %}
      <tr>
        <td class="c">{{ line.qty_ord }}</td>
        <td class="c">{{ line.qty_shp }}</td>
        <td class="c">{{ line.bo }}</td>
        <td>{{ line.item_number }}</td>
        <td>{{ line.description }}</td>
        <td class="r">{{ line.unit_price | money }}</td>
        <td class="c">{{ line.uom }}</td>
        <td class="r">{{ line.extended_price | money }}</td>
      </tr>
      {% endfor %}
    </table>

    {% if multi_page %}
      <div class="iq-cont">Continued on next page&hellip;</div>
    {% else %}
      {{ totals_block }}
    {% endif %}

    <div class="iq-foot">
      <span>INK QUEST &nbsp;&bull;&nbsp; 14617 &ndash; 134 Ave NW, Edmonton, AB T5L 4S9</span>
      <span>Invoice {{ invoice.number }} &nbsp;&bull;&nbsp; Page 1 of {% if multi_page %}2{% else %}1{% endif %}</span>
    </div>
  </section>

  <!-- ================= PAGE 2 (only when needed) ================= -->
  {% if multi_page %}
  <section class="iq-page">
    <div class="iq-accent"><div class="t"></div><div class="g"></div></div>
    <div class="iq-hdr">
      <div>
        <div class="iq-brand">INK QUEST<small>(DIV. OF 605494 ALBERTA LTD)</small></div>
        <div class="iq-co">14617 - 134 Ave NW, Edmonton, AB T5L 4S9<br>
          Phone: (780) 454-4321 &nbsp;&nbsp; Fax: (780) 452-5405</div>
      </div>
      <div class="iq-invtitle">
        <div class="iq-contfrom">Continued from page 1</div>
        <div class="t">INVOICE</div>
        <h1>{{ invoice.number }}</h1>
      </div>
    </div>

    <div class="iq-meta1">
      <div><b>CUSTOMER:</b> {{ invoice.sold_to.name }}</div>
      <div><b>ORDER NO.:</b> {{ invoice.order_no }}</div>
      <div><b>DATE:</b> {{ invoice.date }}</div>
      <div><b>PAGE:</b> 2 of 2</div>
    </div>

    <div class="iq-itemsbar">
      <h3>LINE ITEMS: {{ lines_per_page | plus: 1 }} &ndash; {{ invoice.lines.size }}</h3>
      <span class="iq-badge">SAMPLE DATA</span>
    </div>

    <table class="iq-items">
      {{ items_table_head }}
      {% for line in page2_lines %}
      <tr>
        <td class="c">{{ line.qty_ord }}</td>
        <td class="c">{{ line.qty_shp }}</td>
        <td class="c">{{ line.bo }}</td>
        <td>{{ line.item_number }}</td>
        <td>{{ line.description }}</td>
        <td class="r">{{ line.unit_price | money }}</td>
        <td class="c">{{ line.uom }}</td>
        <td class="r">{{ line.extended_price | money }}</td>
      </tr>
      {% endfor %}
    </table>

    {{ totals_block }}

    <div class="iq-foot">
      <span>INK QUEST &nbsp;&bull;&nbsp; 14617 &ndash; 134 Ave NW, Edmonton, AB T5L 4S9</span>
      <span>Invoice {{ invoice.number }} &nbsp;&bull;&nbsp; Page 2 of 2</span>
    </div>
  </section>
  {% endif %}

</div>

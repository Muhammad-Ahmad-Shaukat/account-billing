
{% assign wishlist_url = 'https://inkquestca.myshopify.com/apps/wishlist' %}  

<style>
  .rd-wrap{--teal:#0d4f4f;--teal-light:#e8f3f1;--border:#e5e5e0;--text:#1a1a1a;--muted:#6b7280;--bg:#faf9f7;
    max-width:80%;margin:10px auto;padding:16px;color:var(--text);}
  .rd-header{background:var(--teal);color:#fff;padding:16px 20px;border-radius:10px;
    display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;}
  .rd-header .rd-store{font-weight:700;font-size:17px;}
  .rd-header .rd-store span{opacity:.7;font-weight:400;font-size:13px;margin-left:6px;}
  .rd-avatar{width:32px;height:32px;border-radius:50%;background:#fff;color:var(--teal);
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;}

  .rd-body{display:flex;gap:18px;align-items:flex-start;}
  .rd-sidebar{width:230px;flex-shrink:0;background:var(--bg);border:1px solid var(--border);
    border-radius:10px;padding:10px;position:sticky;top:12px;}
  .rd-nav-btn{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;
    border:none;padding:10px 12px;border-radius:8px;font-size:14px;color:var(--text);
    cursor:pointer;margin-bottom:4px;font-family:inherit;text-decoration:none;box-sizing:border-box;}
  .rd-nav-btn.active{background:var(--teal-light);color:var(--teal);font-weight:600;}
  .rd-nav-btn:hover{background:var(--teal-light);}
  .rd-nav-divider{height:1px;background:var(--border);margin:8px 4px;}
  .rd-nav-btn.rd-logout{color:#b3261e;}

  .rd-main{flex:1;min-width:0;}
  .rd-section{display:none;}
  .rd-section.active{display:block;}

  .rd-greet h2{margin:10px 0 4px;font-size:21px;}
  .rd-greet p{margin:0;color:var(--muted);font-size:14px;}

  .rd-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0;}
  .rd-stat{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px;}
  .rd-stat .rd-label{font-size:12px;color:var(--muted);margin-bottom:6px;}
  .rd-stat .rd-value{font-size:24px;font-weight:700;line-height:1.1;}
  .rd-stat .rd-sub{font-size:11px;color:var(--muted);margin-top:4px;}

  .rd-card-title{display:flex;justify-content:space-between;align-items:center;margin:22px 0 6px;}
  .rd-card-title h3{margin:0;font-size:16px;}
  .rd-card-title a{color:var(--teal);font-size:13px;text-decoration:none;font-weight:600;cursor:pointer;}

  table.rd-table{width:100%;border-collapse:collapse;margin-top:8px;font-size:14px;}
  table.rd-table th{text-align:left;font-size:12px;color:var(--muted);font-weight:600;
    padding:10px 8px;border-bottom:1px solid var(--border);white-space:nowrap;}
  table.rd-table td{padding:12px 8px;border-bottom:1px solid var(--border);white-space:nowrap;}

  .rd-badge{padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;display:inline-block;}
  .rd-badge.fulfilled{background:#dcf5e6;color:#1a7a3f;}
  .rd-badge.unfulfilled{background:#fdecd2;color:#9a6a12;}
  .rd-badge.partial{background:#e6e6fa;color:#4b3f9a;}

  .rd-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 24px;margin-top:14px;}
  .rd-info-grid .rd-info-item{font-size:14px;padding:10px 0;border-bottom:1px solid var(--border);}
  .rd-info-grid .rd-info-item strong{display:block;font-size:11px;color:var(--muted);
    text-transform:uppercase;letter-spacing:.03em;margin-bottom:3px;}
  .rd-account-info a{color:var(--teal);}

  .rd-addr-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}
  .rd-addr-card{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;font-size:14px;line-height:1.6;}
  .rd-addr-card .rd-addr-badge{display:inline-block;background:var(--teal-light);color:var(--teal);
    font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;margin-bottom:8px;}

  .rd-table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}

  .rd-wishlist-frame{width:100%;height:70vh;min-height:420px;border:1px solid var(--border);
    border-radius:10px;background:#fff;}

  .rd-chart{display:flex;align-items:flex-end;gap:14px;height:180px;margin-top:20px;
    padding:10px 6px 0;border-bottom:1px solid var(--border);}
  .rd-chart-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;}
  .rd-chart-bar{width:70%;max-width:40px;background:var(--teal);border-radius:4px 4px 0 0;
    min-height:2px;transition:height .3s ease;}
  .rd-chart-val{font-size:11px;color:var(--text);margin-bottom:4px;font-weight:600;}
  .rd-chart-label{font-size:11px;color:var(--muted);margin-top:8px;}

  @media(max-width:768px){
    .rd-body{flex-direction:column;}
    .rd-sidebar{width:100%;display:flex;overflow-x:auto;gap:6px;padding:8px;position:static;}
    .rd-nav-btn{white-space:nowrap;margin-bottom:0;width:auto;}
    .rd-nav-divider{display:none;}
    .rd-stats{grid-template-columns:1fr 1fr;}
    .rd-info-grid{grid-template-columns:1fr;}
    .rd-addr-grid{grid-template-columns:1fr;}
    .rd-wrap{ max-width:100%;}
  }
  
.rd-new-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-top:20px;
}

.rd-product-card{
border:1px solid #eee;
padding:15px;
border-radius:10px;
background:#fff;
}

.rd-product-card img{
width:100%;
aspect-ratio:1;
object-fit:cover;
}

.rd-product-card button{
width:100%;
margin-top:10px;
height:42px;
background:#00404c;
color:#fff;
border:none;
cursor:pointer;
}

@media(max-width:991px){
.rd-new-grid{
grid-template-columns:repeat(2,1fr);
}
}

@media(max-width:767px){
.rd-new-grid{
grid-template-columns:1fr;
}
}
.rd-pagination{

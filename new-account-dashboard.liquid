    line-height:1;
    font-weight:750;
    color:#111827;
  }

  .rd-invoice-stat-sub{
    margin-top:7px;
    font-size:11px;
    color:#8a9297;
  }


  /* =====================================================
     TOOLBAR
  ===================================================== */

  .rd-invoice-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    margin-bottom:14px;
    flex-wrap:wrap;
  }

  .rd-invoice-search{
    position:relative;
    flex:1 1 220px;
    min-width:180px;
  }

  .rd-invoice-search svg{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    color:#8a9297;
    pointer-events:none;
  }

  .rd-invoice-search input{
    width:100%;
    height:46px;
    padding:0 16px 0 42px;
    border:1px solid #dedfdf;
    border-radius:10px;
    background:#fff;
    outline:none;
    font-family:inherit;
    font-size:14px;
    box-sizing:border-box;
  }

  .rd-invoice-search input:focus{
    border-color:#0d4f4f;
    box-shadow:0 0 0 3px rgba(13,79,79,.08);
  }

  .rd-invoice-filter{
    height:46px;
    padding:0 14px;
    border:1px solid #dedfdf;
    border-radius:10px;
    background:#fff;
    color:#263238;
    font-family:inherit;
    font-size:13px;
    outline:none;
    cursor:pointer;
  }


  /* =====================================================
     INVOICE TABLE
  ===================================================== */

  .rd-invoice-table-card{
    background:#fff;
    border:1px solid #e5e5e0;
    border-radius:14px;
    overflow:hidden;
  }

  .rd-invoice-table-scroll{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }

  table.rd-invoice-table{
    width:100%;
    border-collapse:collapse;
    min-width:900px;
    font-size:13px;
  }

  .rd-invoice-table th{
    background:#faf9f7;
    padding:13px 14px;
    text-align:left;
    color:#6b7280;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.04em;
    border-bottom:1px solid #e5e5e0;
    white-space:nowrap;
  }

  .rd-invoice-table td{
    padding:15px 14px;
    border-bottom:1px solid #eeeeeb;
    color:#263238;
    vertical-align:middle;
    white-space:nowrap;
  }

  .rd-invoice-table tbody tr:last-child td{
    border-bottom:none;
  }

  .rd-invoice-table tbody tr:hover{
    background:#fcfcfb;
  }

  .rd-invoice-number{
    font-weight:700;
    color:#0d4f4f;
  }

  .rd-invoice-order{
    font-size:12px;
    color:#6b7280;
    margin-top:3px;
  }

  .rd-invoice-total{
    font-weight:700;
    color:#111827;
  }


  /* =====================================================
     STATUS
  ===================================================== */

  .rd-invoice-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 9px;
    border-radius:999px;
    font-size:11px;
    font-weight:700;
  }

  .rd-invoice-badge.paid{
    background:#dcf5e6;
    color:#1a7a3f;
  }

  .rd-invoice-badge.pending{
    background:#fff2d8;
    color:#9a6a12;
  }

  .rd-invoice-badge.failed{
    background:#fde8e8;
    color:#b3261e;
  }

  .rd-invoice-badge.processing{
    background:#e8edf7;
    color:#42526e;
  }


  /* =====================================================
     ACTION BUTTONS
  ===================================================== */

  .rd-invoice-actions{
    display:flex;
    gap:6px;
  }

  .rd-invoice-action{
    width:34px;
    height:34px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid #dedfdf;
    border-radius:8px;
    background:#fff;
    color:#344054;
    cursor:pointer;
    transition:.2s ease;
  }

  .rd-invoice-action:hover{
    border-color:#0d4f4f;
    color:#0d4f4f;
    background:#e8f3f1;
  }

  .rd-invoice-action.send{
    width:auto;
    padding:0 11px;
    gap:6px;
    font-size:11px;
    font-weight:700;
  }


  /* =====================================================
     EMPTY
  ===================================================== */

  .rd-invoice-empty{
    text-align:center;
    padding:70px 20px;
  }

  .rd-invoice-empty-icon{
    width:58px;
    height:58px;
    margin:0 auto 14px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#e8f3f1;
    color:#0d4f4f;
  }

  .rd-invoice-empty h3{
    margin:0 0 6px;
    font-size:18px;
  }

  .rd-invoice-pager{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-top:14px;
    flex-wrap:wrap;
  }
  .rd-invoice-pager-info{
    font-size:13px;
    color:var(--muted);
  }
  .rd-invoice-pager-btns{
    display:flex;
    gap:8px;
  }
  .rd-invoice-pager-btn{
    border:1px solid var(--border);
    background:#fff;
    color:var(--teal);
    border-radius:8px;
    padding:8px 14px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    font-family:inherit;
  }
  .rd-invoice-pager-btn:disabled{
    opacity:.45;
    cursor:not-allowed;
  }
  .rd-invoice-loading,
  .rd-invoice-error{
    padding:28px 16px;
    text-align:center;
    color:var(--muted);
    font-size:14px;
  }
  .rd-invoice-error{ color:#b3261e; }

  .rd-invoice-empty{
    padding:36px 16px;
    text-align:center;
  }
  .rd-invoice-empty h3{
    margin:0 0 6px;
    font-size:18px;
  }
  .rd-invoice-empty p{
    margin:0;
    color:#6b7280;
    font-size:13px;
  }
  .rd-invoice-refresh{
    margin-top:16px;
    border:1px solid var(--border);
    background:#fff;
    color:var(--teal);
    border-radius:8px;
    padding:10px 18px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    font-family:inherit;
  }
  .rd-invoice-refresh:hover{
    background:var(--teal-light);
  }


  /* =====================================================
     INVOICE MODAL
  ===================================================== */

  .rd-invoice-modal{
    position:fixed;
    inset:0;
    z-index:9999;
    background:rgba(0,0,0,.48);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
  }

  .rd-invoice-modal.active{
    display:flex;
  }

  .rd-invoice-modal-box{
    width:min(100%,1100px);
    max-height:92vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    box-shadow:0 30px 100px rgba(0,0,0,.25);
  }

  .rd-invoice-modal-top{
    position:sticky;
    top:0;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 18px;
    background:#fff;
    border-bottom:1px solid #eeeeeb;
  }

  .rd-invoice-modal-title{
    font-size:14px;
    font-weight:700;
  }

  .rd-invoice-modal-close{
    width:34px;
    height:34px;
    border:0;
    border-radius:8px;
    background:#f3f4f6;
    cursor:pointer;
    font-size:18px;
  }


  /* =====================================================
     ACTUAL INVOICE (Design 2 — modern corporate)
  ===================================================== */

  .rd-print-invoice{
    padding:18px;
    color:#1c2b33;
    background:#fff;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x:auto;
  }

  .iq-invoice{
    font-family: Arial, Helvetica, sans-serif;
    color:#1c2b33;
    max-width:8.5in;
    margin:0 auto;
  }
  .iq-invoice *{ box-sizing:border-box; }
  .iq-page{
    width:100%;
    min-width:720px;
    padding:18px 22px;
    position:relative;
    background:#fff;
    border:1px solid #d9e0de;
    border-radius:8px;
  }
  .iq-page + .iq-page{ margin-top:18px; }
  .iq-accent{ display:flex; height:4px; margin-bottom:14px; }
  .iq-accent .t{ flex:0 0 80%; background:#074a53; }
  .iq-accent .g{ flex:1; background:#bad246; }
  .iq-hdr{ display:flex; justify-content:space-between; align-items:flex-start; }
  .iq-logo{ width:72px; height:auto; max-height:56px; object-fit:contain; display:block; margin-bottom:6px; }
  .iq-brand{ font-size:21px; font-weight:700; letter-spacing:6px; color:#074a53; }
  .iq-brand small{ display:block; font-size:10px; font-weight:400; letter-spacing:1px; color:#5b6b72; margin-top:3px; }
  .iq-co{ font-size:11px; line-height:1.55; margin-top:8px; }
  .iq-invtitle{ text-align:right; }
  .iq-invtitle .t{ font-size:10px; font-weight:600; letter-spacing:3px; color:#074a53; }
  .iq-invtitle h1{ font-size:27px; font-weight:700; margin:2px 0 8px; }
  .iq-dpt{ display:flex; gap:18px; justify-content:flex-end; }
  .iq-dpt div{ text-align:right; }
  .iq-dpt span{ display:block; font-size:9px; font-weight:600; letter-spacing:1px; color:#5b6b72; }
  .iq-dpt b{ font-size:12px; font-weight:600; }
  .iq-contfrom{ font-size:11px; color:#5b6b72; text-align:right; margin-bottom:4px; }
  .iq-addr{ display:flex; gap:24px; margin-top:16px; }
  .iq-addr > div{
    flex:1;
    border:1px solid #d9e0de;
    border-top:4px solid #074a53;
    border-radius:0 0 8px 8px;
    padding:10px 14px;
  }
  .iq-lbl{ font-size:10px; font-weight:600; letter-spacing:1.5px; color:#074a53; margin-bottom:5px; }
  .iq-addr p{ font-size:12.5px; line-height:1.55; margin:0; }
  .iq-meta{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    margin-top:14px;
    border:1px solid #d9e0de;
    border-radius:8px;
    overflow:hidden;
  }
  .iq-meta div{ padding:8px 14px; font-size:12px; border-left:1px solid #d9e0de; }
  .iq-meta div:nth-child(4n+1){ border-left:none; }
  .iq-meta div:nth-child(n+5){ border-top:1px solid #d9e0de; }
  .iq-meta span{ display:block; font-size:9px; font-weight:600; letter-spacing:1px; color:#5b6b72; }
  .iq-meta1{
    display:flex;
    margin-top:14px;
    border:1px solid #d9e0de;
    border-radius:8px;
    padding:10px 14px;
    font-size:11.5px;
  }
  .iq-meta1 div{ flex:1; white-space:nowrap; }
  .iq-meta1 div:first-child{ flex:1.9; }
  .iq-meta1 b{ font-weight:600; }
  .iq-itemsbar{ display:flex; justify-content:space-between; align-items:center; margin:14px 0 8px; }
  .iq-itemsbar h3{ font-size:14px; font-weight:600; margin:0; }
  .iq-items{ width:100%; border-collapse:collapse; font-size:12px; }
  .iq-items th{
    background:#074a53;
    color:#fff;
    font-size:10px;
    font-weight:600;
    letter-spacing:.8px;
    padding:8px 6px;
    text-align:left;
  }
  .iq-items td{ padding:9px 6px; border-bottom:1px solid #e6ebea; vertical-align:top; font-size:11.5px; }
  .iq-items .c{ text-align:center; }
  .iq-items .r{ text-align:right; }
  .iq-cont{ text-align:center; font-size:12px; font-weight:600; color:#074a53; padding-top:10px; }
  .iq-bottom{ display:flex; gap:22px; margin-top:16px; }
  .iq-left{ flex:1.25; font-size:11.5px; }
  .iq-gst{ font-size:12px; font-weight:600; color:#074a53; margin-bottom:8px; }
  .iq-left p{ margin:0 0 5px; line-height:1.5; }
  .iq-pm{ border-top:1px solid #d9e0de; margin-top:14px; padding-top:12px; }
  .iq-pm h3{ font-size:12.5px; font-weight:700; color:#074a53; letter-spacing:1px; margin:0 0 8px; }
  .iq-pm h4{ font-size:11.5px; font-weight:600; color:#074a53; margin:8px 0 4px; }
  .iq-pm-sub{ border-top:1px dashed #d9e0de; margin-top:8px; padding-top:8px; }
  .iq-right{ flex:1; }
  .iq-taxbox{ background:#f2f5f4; border-radius:8px; padding:10px 14px; margin-bottom:12px; }
  .iq-taxbox h3{ font-size:10.5px; font-weight:700; letter-spacing:1.5px; color:#074a53; margin:0 0 6px; }
  .iq-trow{ display:flex; justify-content:space-between; font-size:12.5px; padding:4px 0; }
  .iq-due{
    background:#2ea05f;
    color:#fff;
    border-radius:8px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px 14px;
    margin-top:8px;
    font-size:14.5px;
    font-weight:700;
  }
  .iq-foot{
    display:flex;
    justify-content:space-between;
    font-size:10.5px;
    color:#5b6b72;
    border-top:1px solid #d9e0de;
    padding-top:8px;
    margin-top:24px;
  }


  /* =====================================================
     MODAL BUTTONS
  ===================================================== */

  .rd-invoice-modal-actions{
    display:flex;
    gap:8px;
  }

  .rd-invoice-modal-btn{
    height:36px;
    padding:0 13px;
    border-radius:8px;
    border:1px solid #d9dddd;
    background:#fff;
    cursor:pointer;
    font-size:12px;
    font-weight:700;
  }

  .rd-invoice-modal-btn.primary{
    background:#0d4f4f;
    color:#fff;
    border-color:#0d4f4f;
  }


  /* =====================================================
     ERP SEND STATUS
  ===================================================== */

  .rd-erp-status{
    margin:15px 40px 0;
    padding:11px 13px;
    border-radius:9px;
    display:none;
    font-size:12px;
    font-weight:600;
  }

  .rd-erp-status.show{
    display:block;
  }

  .rd-erp-status.success{
    background:#dcf5e6;
    color:#1a7a3f;
  }

  .rd-erp-status.error{
    background:#fde8e8;
    color:#b3261e;
  }

  .rd-erp-status.loading{
    background:#f3f4f6;
    color:#475467;
  }


  /* =====================================================
     RESPONSIVE
  ===================================================== */

  @media(max-width:991px){

    .rd-invoice-stats{
      grid-template-columns:repeat(2,1fr);
    }

    .rd-print-info{
      grid-template-columns:1fr 1fr;
    }

    .rd-print-bottom{
      grid-template-columns:1fr;
    }

  }


  @media(max-width:767px){

    .rd-invoice-hero{
      flex-direction:column;
    }

    .rd-invoice-hero h2{
      font-size:23px;
    }

    .rd-invoice-stats{
      grid-template-columns:1fr 1fr;
      gap:8px;
    }

    .rd-invoice-stat{
      padding:14px;
    }

    .rd-invoice-stat-value{
      font-size:19px;
    }

    .rd-invoice-toolbar{
      flex-direction:column;
      align-items:stretch;
    }

    .rd-invoice-filter{
      width:100%;
    }

    .rd-invoice-modal{
      padding:0;
      align-items:flex-end;
    }

    .rd-invoice-modal-box{
      max-height:96vh;
      border-radius:16px 16px 0 0;
    }

    .rd-print-invoice{
      padding:12px;
    }

    .rd-erp-header{
      grid-template-columns:1fr;
      text-align:center;
    }

    .rd-erp-logo,
    .rd-erp-logo-fallback{
      margin:0 auto;
    }

    .rd-erp-doc{
      text-align:left;
    }

    .rd-erp-parties > tbody > tr{
      display:block;
    }

    .rd-erp-parties > tbody > tr > td{
      display:block;
      width:100% !important;
      padding:0 0 8px !important;
    }

    .rd-erp-footer > tbody > tr{
      display:block;
    }

    .rd-erp-footer > tbody > tr > td{
      display:block;
      width:100% !important;
      padding:0 0 10px !important;
    }

    .rd-invoice-modal-top{
      flex-wrap:wrap;
      gap:10px;
    }

    .rd-invoice-modal-actions{
      width:100%;
    }

    .rd-invoice-modal-btn{
      flex:1;
    }

    .rd-erp-status{
      margin:15px 22px 0;
    }

  }


  /* =====================================================
     PRINT (same-window via hidden iframe — no pop-up)
  ===================================================== */

  #rdInvoicePrintFrame{
    position:fixed !important;
    right:0 !important;
    bottom:0 !important;
    width:0 !important;
    height:0 !important;
    border:0 !important;
    opacity:0 !important;
    pointer-events:none !important;
  }

  @media print{

    @page{
      size: letter portrait;
      margin: 0.35in;
    }

  }

</style>


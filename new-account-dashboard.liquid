/* =========================================================
   QUICK RE-ORDER LIST
========================================================= */

.rd-reorder-head {
  margin-bottom: 18px;
}

.rd-reorder-head h2 {
  margin: 0 0 5px;
  font-size: 24px;
  line-height: 1.2;
  color: #111827;
}

.rd-reorder-head p {
  margin: 0;
  color: #6b7280;
  font-size: 14px;
}


/* SELECT ALL */

.rd-reorder-select-all {
  border: 1px solid #e3e5e7;
  border-radius: 8px;
  padding: 16px 18px;
  margin-bottom: 14px;
  background: #fff;
}

.rd-check-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font-size: 14px;
  color: #263238;
  user-select: none;
}

.rd-reorder-checkbox {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.rd-custom-check {
  width: 18px;
  height: 18px;
  border: 1.5px solid #7b8388;
  border-radius: 3px;
  background: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all .2s ease;
  flex-shrink: 0;
}

.rd-reorder-checkbox:checked + .rd-custom-check {
  background: #0d4f4f;
  border-color: #0d4f4f;
}

.rd-reorder-checkbox:checked + .rd-custom-check::after {
  content: "";
  width: 9px;
  height: 5px;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(-45deg);
  margin-top: -2px;
}


/* PRODUCT ROW */

.rd-reorder-item {
  display: grid;
  grid-template-columns: 34px 112px minmax(220px, 1fr) 100px 135px 135px 46px;
  align-items: center;
  gap: 18px;

  border: 1px solid #dfe2e4;
  background: #fff;

  padding: 18px;
  margin-bottom: 10px;

  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    opacity .25s ease,
    transform .25s ease;
}

.rd-reorder-item:hover {
  border-color: #bfc6c9;
  box-shadow: 0 8px 24px rgba(0,0,0,.05);
}


/* CHECKBOX */

.rd-reorder-check {
  display: flex;
  justify-content: center;
}


/* IMAGE */

.rd-reorder-image {
  width: 112px;
  height: 112px;
  border-radius: 8px;
  background: #fafafa;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rd-reorder-image a {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rd-reorder-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.rd-reorder-no-image {
  color: #999;
  font-size: 11px;
}


/* PRODUCT INFO */

.rd-reorder-info {
  min-width: 0;
}

.rd-reorder-title {
  display: block;
  color: #111827;
  font-size: 16px;
  line-height: 1.4;
  text-decoration: none;
  font-weight: 500;
  margin-bottom: 7px;
}

.rd-reorder-title:hover {
  color: #0d4f4f;
}

.rd-reorder-variant {
  font-size: 13px;
  color: #667085;
  margin-bottom: 5px;
}

.rd-reorder-sku {
  font-size: 12px;
  color: #8a9297;
}


/* PRICE */

.rd-reorder-price {
  font-size: 16px;
  color: #111827;
  font-weight: 600;
  white-space: nowrap;
}

.mobile-price {
  display: none;
}


/* QUANTITY */

.rd-reorder-qty {
  height: 42px;
  display: flex;
  align-items: center;
  border: 1px solid #d5d9dc;
  border-radius: 7px;
  overflow: hidden;
  background: #fff;
}

.rd-qty-btn {
  width: 38px;
  height: 100%;
  border: 0;
  background: #fff;
  color: #253238;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s ease;
}

.rd-qty-btn:hover {
  background: #f3f5f5;
}

.rd-qty-input {
  width: 42px;
  height: 100%;
  border: 0;
  outline: 0;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
  background: #fff;
  appearance: textfield;
}

.rd-qty-input::-webkit-inner-spin-button,
.rd-qty-input::-webkit-outer-spin-button {
  appearance: none;
  margin: 0;
}


/* ADD TO CART */

.rd-reorder-form {
  margin: 0;
}

.rd-reorder-add {
  width: 100%;
  min-width: 120px;
  height: 42px;

  padding: 0 16px;

  border: 1px solid #0d4f4f;
  border-radius: 7px;

  background: #fff;
  color: #0d4f4f;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.rd-reorder-add:hover {
  background: #0d4f4f;
  color: #fff;
}

.rd-reorder-add:disabled {
  opacity: .5;
  cursor: not-allowed;
}


/* REMOVE */

.rd-reorder-remove {
  width: 40px;
  height: 40px;

  border: 1px solid #e0e3e5;
  border-radius: 7px;

  background: #fff;
  color: #6b7280;

  display: flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;

  transition: all .2s ease;
}

.rd-reorder-remove:hover {
  color: #c62828;
  border-color: #e3b5b5;
  background: #fff7f7;
}


/* REMOVED ANIMATION */

.rd-reorder-item.rd-removed {
  opacity: 0;
  transform: translateX(20px);
  pointer-events: none;
}


/* EMPTY */

.rd-reorder-empty {
  border: 1px solid #e3e5e7;
  border-radius: 10px;
  background: #fff;
  padding: 60px 20px;
  text-align: center;
}

.rd-empty-icon {
  width: 50px;
  height: 50px;
  margin: 0 auto 15px;

  border-radius: 50%;
  background: #e8f3f1;
  color: #0d4f4f;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 24px;
}

.rd-reorder-empty h3 {
  margin: 0 0 8px;
  font-size: 18px;
}

.rd-reorder-empty p {
  margin: 0 0 20px;
  color: #6b7280;
  font-size: 14px;
}

.rd-reorder-empty a {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 42px;
  padding: 0 20px;

  background: #0d4f4f;
  color: #fff;

  border-radius: 7px;
  text-decoration: none;

  font-size: 14px;
  font-weight: 600;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width: 1200px) {

  .rd-reorder-item {
    grid-template-columns:
      30px
      90px
      minmax(180px, 1fr)
      80px
      120px
      120px
      40px;

    gap: 12px;
    padding: 14px;
  }

  .rd-reorder-image {
    width: 90px;
    height: 90px;
  }

  .rd-reorder-title {
    font-size: 14px;
  }

  .rd-reorder-add {
    min-width: 110px;
    padding: 0 10px;
  }

}


@media(max-width: 991px) {

  .rd-reorder-item {
    grid-template-columns:
      28px
      85px
      minmax(160px, 1fr)
      110px
      110px
      40px;
  }

  .desktop-price {
    display: none;
  }

  .rd-reorder-qty {
    grid-column: 4;
  }

  .rd-reorder-action {
    grid-column: 5;
  }

  .rd-reorder-remove {
    grid-column: 6;
  }

}


@media(max-width: 767px) {

  .rd-reorder-select-all {
    padding: 14px;
  }

  .rd-reorder-item {

    display: grid;

    grid-template-columns: 28px 82px 1fr 40px;

    gap: 12px;

    padding: 14px;

    border-radius: 10px;

  }


  .rd-reorder-check {
    grid-column: 1;
    grid-row: 1 / span 3;
    align-self: start;
    padding-top: 4px;
  }


  .rd-reorder-image {

    grid-column: 2;
    grid-row: 1 / span 3;

    width: 82px;
    height: 82px;

  }


  .rd-reorder-info {

    grid-column: 3;
    grid-row: 1;

  }


  .rd-reorder-title {
    font-size: 14px;
  }


  .rd-reorder-price.mobile-price {

    display: block;

    margin-top: 7px;
    font-size: 15px;

  }


  .rd-reorder-qty {

    grid-column: 3;
    grid-row: 2;

    width: 118px;
    height: 38px;

  }


  .rd-reorder-action {

    grid-column: 3;
    grid-row: 3;

    margin-top: 4px;

  }


  .rd-reorder-add {
    width: 100%;
    height: 40px;
  }


  .rd-reorder-remove {

    grid-column: 4;
    grid-row: 1;

    width: 36px;
    height: 36px;

  }

}
.side-divider {
    height: 1px;
    background: #caced6;
    margin: 8px 6px;
}
section:empty{
display:block!important;
}


<script>
(function(){
  // Tab switching
  var buttons = document.querySelectorAll('.rd-nav-btn[data-target]');
  buttons.forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      var target = btn.getAttribute('data-target');
      document.querySelectorAll('.rd-sidebar .rd-nav-btn').forEach(function(b){ b.classList.remove('active'); });
      document.querySelectorAll('.rd-sidebar .rd-nav-btn[data-target="' + target + '"]').forEach(function(b){ b.classList.add('active'); });
      document.querySelectorAll('.rd-section').forEach(function(s){ s.classList.remove('active'); });
      document.getElementById(target).classList.add('active');
    });
  });

  function openInvoiceTab(){
    if (window.location.hash !== '#rd-invoices') return;
    var button = document.querySelector('.rd-nav-btn[data-target="rd-invoices"]');
    if (button) button.click();
  }
  openInvoiceTab();
  window.addEventListener('hashchange', openInvoiceTab);

  // Auto-open the New Arrivals tab when arriving via its pagination (?page=N or #rd-new-arrivals)
  try {
    var _nap = new URLSearchParams(window.location.search);
    var _nan = parseInt(_nap.get('page') || '1', 10);
    if ((_nan > 1 && !window.location.hash) || window.location.hash === '#rd-new-arrivals') {
      var _nab = document.querySelector('.rd-nav-btn[data-target="rd-new-arrivals"]');
      if (_nab) {
        _nab.click();
        var _nas = document.getElementById('rd-new-arrivals');
        if (_nas && _nas.scrollIntoView) setTimeout(function(){ _nas.scrollIntoView({ block: 'start' }); }, 60);
      }
    }
  } catch (_nae) {}

  // Build "last 6 months" spend chart from real order data
  try {
    var raw = JSON.parse(document.getElementById('rd-orders-json').textContent || '[]');
    var months = [];
    var now = new Date();
    for (var i = 5; i >= 0; i--) {
      var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      months.push({ key: d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'),
                    label: d.toLocaleString('default', { month: 'short' }),
                    total: 0 });
    }
    raw.forEach(function(o){
      var key = o.date.slice(0, 7);
      var m = months.find(function(mm){ return mm.key === key; });
      if (m) m.total += o.total;
    });
    var maxTotal = Math.max.apply(null, months.map(function(m){ return m.total; })) || 1;
    var chart = document.getElementById('rd-chart');
    var moneyFmt = {{ shop.money_format | json }};
    function formatMoney(cents){
      var amount = (cents / 100).toFixed(2);
      return moneyFmt.replace(/\{\{\s*amount\s*\}\}/, amount);
    }
    months.forEach(function(m){
      var pct = Math.round((m.total / maxTotal) * 100);
      var col = document.createElement('div');
      col.className = 'rd-chart-col';
      col.innerHTML =
        '<div class="rd-chart-val">' + (m.total > 0 ? formatMoney(m.total) : '') + '</div>' +
        '<div class="rd-chart-bar" style="height:' + Math.max(pct, 2) + '%"></div>' +
        '<div class="rd-chart-label">' + m.label + '</div>';
      chart.appendChild(col);
    });
  } catch (err) {
    console.error('Spending chart error:', err);
  }
})();




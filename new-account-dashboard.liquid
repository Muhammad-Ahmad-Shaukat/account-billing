<script>
  const hour = new Date().getHours();
  let greeting;

  if (hour < 12) {
    greeting = "Good morning";
  } else if (hour < 18) {
    greeting = "Good afternoon";
  } else {
    greeting = "Good evening";
  }

  document.getElementById("greeting").innerText = greeting;


  /* =========================================================
   QUICK RE-ORDER
========================================================= */

(function () {

  var reorderItems = document.querySelectorAll(
    '[data-reorder-item]'
  );

  var selectAll = document.getElementById(
    'rdReorderSelectAll'
  );


  /*
   * SELECT ALL
   */

  if (selectAll) {

    selectAll.addEventListener('change', function () {

      var checked = this.checked;

      document
        .querySelectorAll('.rd-item-checkbox')
        .forEach(function (checkbox) {

          checkbox.checked = checked;

        });

    });

  }


  /*
   * INDIVIDUAL CHECKBOXES
   */

  document
    .querySelectorAll('.rd-item-checkbox')
    .forEach(function (checkbox) {

      checkbox.addEventListener('change', function () {

        if (!selectAll) return;

        var all = document.querySelectorAll(
          '.rd-item-checkbox'
        );

        var checked = document.querySelectorAll(
          '.rd-item-checkbox:checked'
        );

        selectAll.checked =
          all.length > 0 &&
          checked.length === all.length;

      });

    });


  /*
   * QUANTITY
   */

  reorderItems.forEach(function (item) {

    var minus = item.querySelector('.rd-qty-minus');
    var plus = item.querySelector('.rd-qty-plus');
    var input = item.querySelector('.rd-qty-input');
    var hiddenQuantity = item.querySelector(
      '.rd-hidden-quantity'
    );


    if (!input) return;


    function updateQuantity(value) {

      value = parseInt(value, 10);

      if (isNaN(value)) {
        value = 1;
      }

      value = Math.max(1, Math.min(99, value));

      input.value = value;

      if (hiddenQuantity) {
        hiddenQuantity.value = value;
      }

    }


    if (minus) {

      minus.addEventListener('click', function () {

        updateQuantity(
          parseInt(input.value, 10) - 1
        );

      });

    }


    if (plus) {

      plus.addEventListener('click', function () {

        updateQuantity(
          parseInt(input.value, 10) + 1
        );

      });

    }


    input.addEventListener('input', function () {

      updateQuantity(this.value);

    });


    /*
     * ADD TO CART
     */

    var form = item.querySelector(
      '.rd-reorder-form'
    );

    if (form) {

      form.addEventListener('submit', function () {

        if (hiddenQuantity) {

          hiddenQuantity.value =
            input.value || 1;

        }

      });

    }


    /*
     * REMOVE FROM CURRENT LIST
     */

    var remove = item.querySelector(
      '.rd-reorder-remove'
    );

    if (remove) {

      remove.addEventListener('click', function () {

        item.classList.add('rd-removed');

        setTimeout(function () {

          item.remove();

          var remaining =
            document.querySelectorAll(
              '[data-reorder-item]'
            );

          if (remaining.length === 0) {

            var list =
              document.querySelector(
                '.rd-reorder-list'
              );

            if (list) {

              list.innerHTML =
                '<div class="rd-reorder-empty">' +
                '<div class="rd-empty-icon">↻</div>' +
                '<h3>No products selected</h3>' +
                '<p>Your reorder list is currently empty.</p>' +
                '<a href="{{ routes.all_products_collection_url }}">Shop Products</a>' +
                '</div>';

            }

          }

        }, 250);

      });

    }

  });

})();

/* =========================================================
   QUICK RE-ORDER — saved list from product pages
   Merges products saved via the "Add to Quick Re-Order List"
   button (localStorage) into the reorder list.
========================================================= */
(function () {
  var KEY = 'iq_quick_reorder';
  var PLACEHOLDER = 'https://cdn.shopify.com/s/files/1/0981/0844/0757/files/Ink_Quest.png?v=1786686761';

  function getSaved() {
    try {
      var v = JSON.parse(localStorage.getItem(KEY));
      return Array.isArray(v) ? v : [];
    } catch (e) { return []; }
  }
  function setSaved(v) {
    try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {}
  }
  function esc(t) {
    return String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function money(cents) {
    var n = parseInt(cents, 10);
    if (isNaN(n)) n = 0;
    return 'CAD$' + (n / 100).toFixed(2);
  }

  var listEl = document.querySelector('#rd-reorder .rd-reorder-list');
  if (!listEl) return;

  var saved = getSaved();
  if (!saved.length) return;

  var existing = {};
  listEl.querySelectorAll('[data-reorder-item]').forEach(function (el) {
    existing[el.getAttribute('data-product-id') + '-' + el.getAttribute('data-variant-id')] = true;
  });

  var pending = saved.filter(function (s) {
    return s && s.handle && !existing[s.product_id + '-' + s.variant_id];
  });
  if (!pending.length) return;

  var selectAll = document.getElementById('rdReorderSelectAll');

  function showEmptyState() {
    listEl.innerHTML =
      '<div class="rd-reorder-empty">' +
      '<div class="rd-empty-icon">\u21bb</div>' +
      '<h3>No products selected</h3>' +
      '<p>Your reorder list is currently empty.</p>' +
      '<a href="{{ routes.all_products_collection_url }}">Shop Products</a>' +
      '</div>';
  }

  function wireItem(item, savedEntry) {
    var minus = item.querySelector('.rd-qty-minus');
    var plus = item.querySelector('.rd-qty-plus');
    var input = item.querySelector('.rd-qty-input');
    var hidden = item.querySelector('.rd-hidden-quantity');

    function upd(v) {
      v = parseInt(v, 10);
      if (isNaN(v)) v = 1;
      v = Math.max(1, Math.min(99, v));
      if (input) input.value = v;
      if (hidden) hidden.value = v;
    }
    if (minus) minus.addEventListener('click', function () { upd(parseInt(input.value, 10) - 1); });
    if (plus) plus.addEventListener('click', function () { upd(parseInt(input.value, 10) + 1); });
    if (input) input.addEventListener('input', function () { upd(this.value); });

    var form = item.querySelector('.rd-reorder-form');
    if (form) {
      form.addEventListener('submit', function () {
        if (hidden) hidden.value = (input && input.value) || 1;
      });
    }

    var cb = item.querySelector('.rd-item-checkbox');
    if (cb) {
      cb.addEventListener('change', function () {
        if (!selectAll) return;
        var all = document.querySelectorAll('.rd-item-checkbox');
        var checked = document.querySelectorAll('.rd-item-checkbox:checked');
        selectAll.checked = all.length > 0 && checked.length === all.length;
      });
    }

    var rm = item.querySelector('.rd-reorder-remove');
    if (rm) {
      rm.addEventListener('click', function () {
        setSaved(getSaved().filter(function (x) {
          return String(x.variant_id) !== String(savedEntry.variant_id);
        }));
        item.classList.add('rd-removed');
        setTimeout(function () {
          item.remove();
          if (!document.querySelectorAll('[data-reorder-item]').length) showEmptyState();
        }, 250);
      });
    }
  }

  function buildItem(d) {
    var el = document.createElement('div');
    el.className = 'rd-reorder-item';
    el.setAttribute('data-reorder-item', '');
    el.setAttribute('data-product-id', d.product_id);
    el.setAttribute('data-variant-id', d.variant_id);
    el.setAttribute('data-saved', '1');

    var img = d.image || PLACEHOLDER;
    var skuHtml = d.sku
      ? '<div class="rd-reorder-sku">SKU: ' + esc(d.sku) + '</div>'
      : '';
    var btnHtml = d.available ? 'Add to cart' : 'Sold out';
    var disabled = d.available ? '' : ' disabled';

    el.innerHTML =
      '<div class="rd-reorder-check">' +
        '<label class="rd-check-label">' +
          '<input type="checkbox" class="rd-reorder-checkbox rd-item-checkbox">' +
          '<span class="rd-custom-check"></span>' +
        '</label>' +
      '</div>' +
      '<div class="rd-reorder-image">' +
        '<a href="' + esc(d.url) + '"><img src="' + esc(img) + '" alt="' + esc(d.title) + '" loading="lazy"></a>' +
      '</div>' +
      '<div class="rd-reorder-info">' +
        '<a href="' + esc(d.url) + '" class="rd-reorder-title">' + esc(d.title) + '</a>' +
        skuHtml +
        '<div class="rd-reorder-price mobile-price">' + esc(d.price_text) + '</div>' +
      '</div>' +
      '<div class="rd-reorder-price desktop-price">' + esc(d.price_text) + '</div>' +
      '<div class="rd-reorder-qty">' +
        '<button type="button" class="rd-qty-btn rd-qty-minus" aria-label="Decrease quantity">\u2212</button>' +
        '<input type="number" class="rd-qty-input" value="1" min="1" max="99" aria-label="Quantity">' +
        '<button type="button" class="rd-qty-btn rd-qty-plus" aria-label="Increase quantity">+</button>' +
      '</div>' +
      '<div class="rd-reorder-action">' +
        '<form method="post" action="/cart/add" class="rd-reorder-form">' +
          '<input type="hidden" name="id" value="' + esc(d.variant_id) + '">' +
          '<input type="hidden" name="quantity" value="1" class="rd-hidden-quantity">' +
          '<button type="submit" class="rd-reorder-add"' + disabled + '>' + btnHtml + '</button>' +
        '</form>' +
      '</div>' +
      '<button type="button" class="rd-reorder-remove" aria-label="Remove product" title="Remove">' +
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5"/><path d="M14 11v5"/>' +
        '</svg>' +
      '</button>';
    return el;
  }

  var emptyEl = listEl.querySelector('.rd-reorder-empty');
  if (emptyEl) emptyEl.remove();

  pending.forEach(function (s) {
    fetch('/products/' + encodeURIComponent(s.handle) + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (p) {
        if (!p || !p.variants || !p.variants.length) return;
        var v = null;
        p.variants.forEach(function (x) {
          if (String(x.id) === String(s.variant_id)) v = x;
        });
        if (!v) v = p.variants[0];
        if (document.querySelector('[data-reorder-item][data-variant-id="' + v.id + '"]')) return;

        var img = null;
        if (v.featured_image && v.featured_image.src) img = v.featured_image.src;
        else if (typeof p.featured_image === 'string') img = p.featured_image;

        var el = buildItem({
          product_id: p.id,
          variant_id: v.id,
          title: p.title,
          url: '/products/' + p.handle,
          image: img,
          sku: v.sku,
          price_text: money(v.price),
          available: v.available
        });
        listEl.appendChild(el);
        wireItem(el, s);
      })
      .catch(function () {});
  });
})();
</script>

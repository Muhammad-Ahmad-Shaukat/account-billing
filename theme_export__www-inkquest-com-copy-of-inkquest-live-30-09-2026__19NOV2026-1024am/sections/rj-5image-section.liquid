
{% schema %}
{
  "name": "Dynamic Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Product Categories"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Section Description",
      "default": "A full range of print solutions, all under one roof:"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Category Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Image Heading",
          "default": "Product Category"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Image Description",
          "default": "Explore our products"
        },
        {
          "type": "url",
          "id": "collection_link",
          "label": "Link to Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Product Grid",
      "category": "Custom",
      "blocks": [
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" }
      ]
    }
  ]
}
{% endschema %}

<style>
.dynamic-product-section {
  width: 100%;
}
.dynamic-product-section .category-section-heading {
  text-align: center;
  font-weight: 800;
  margin-top: 80px;
  color: #00404C;
  font-size: 26px;
  margin-bottom: 10px;
}
.dynamic-product-section .category-section-subheading {
  text-align: center;
  margin: 0 15px 0;
  color: #555555;
}
/* Sample A: clean cards, text below image.
   Grid width matches the section below ("Working with Ink Quest..."):
   that section uses .page-width, which is max-width 75% on desktop,
   so this grid uses the same 75% (old grid used 75% too). */
.iq-cat-a-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 20px;
  align-items: stretch;
  padding: 30px 0;
  max-width: 75%;
  width: 100%;
  margin: auto;
  box-sizing: border-box;
}
.iq-cat-a-card {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: rgba(50, 50, 93, 0.12) 0px 6px 12px -2px, rgba(0, 0, 0, 0.12) 0px 3px 7px -3px;
  min-width: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.iq-cat-a-card a {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  color: inherit;
  text-decoration: none;
}
.iq-cat-a-card img {
  width: 100%;
  height: 210px;
  object-fit: cover;
  display: block;
}
.iq-cat-a-body {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  padding: 16px;
}
.iq-cat-a-body h3 {
  margin: 0 0 6px;
  padding: 0;
  font-size: 20px;
  line-height: 1.3;
  font-weight: 600;
  color: #00404c;
  overflow-wrap: anywhere;
}
.iq-cat-a-body p {
  margin: 0;
  padding: 0;
  font-size: 15px;
  line-height: 1.5;
  font-weight: 400;
  color: #555555;
}
.iq-cat-a-explore {
  margin-top: auto;
  padding-top: 14px;
  font-size: 15px;
  font-weight: 600;
  color: #00404c;
}
/* Tablet */
@media (max-width: 1024px) {
  .iq-cat-a-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 24px 0;
    max-width: 75%;
  }
  .iq-cat-a-card img {
    height: 190px;
  }
  .iq-cat-a-body h3 {
    font-size: 18px;
  }
  .iq-cat-a-body p {
    font-size: 14px;
  }
}
/* Mobile */
@media (max-width: 768px) {
  .dynamic-product-section .category-section-heading {
    margin-top: 35px;
    font-size: 24px;
  }
  .iq-cat-a-grid {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    width: 100%;
    padding: 20px 20px 0;
    gap: 15px;
  }
  .iq-cat-a-card {
    width: 100%;
  }
  .iq-cat-a-card img {
    height: 220px;
  }
  .iq-cat-a-body h3 {
    font-size: 20px;
  }
  .iq-cat-a-body p {
    font-size: 15px;
  }
}
</style>

<div class="dynamic-product-section">
  {% if section.settings.section_heading != blank %}
    <h2 class="category-section-heading">
      {{ section.settings.section_heading | escape }}
    </h2>
  {% endif %}
  {% if section.settings.section_subheading != blank %}
    <p class="category-section-subheading">
      {{ section.settings.section_subheading | escape }}
    </p>
  {% endif %}
  <div class="iq-cat-a-grid">
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <div class="iq-cat-a-card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.collection_link | default: '#' }}">
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.heading | default: 'Product category' | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
            <div class="iq-cat-a-body">
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description | escape }}</p>
              {% endif %}
              <span class="iq-cat-a-explore">Explore &gt;</span>
            </div>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

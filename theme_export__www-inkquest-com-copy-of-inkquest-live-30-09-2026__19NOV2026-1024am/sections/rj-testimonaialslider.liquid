<section
  class="testimonial-slider"
  style="color: {{ section.settings.text_color }};"
>
  <div class="testimonial-container">
    <div class="swiper testimonialSwiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide testimonial-slide">
            <div class="testimonial-inner" style="background-color: {{ section.settings.background_color }};">
              {% if block.settings.photo != blank %}
                <div class="testimonial-avatar">
                  <img src="{{ block.settings.photo | img_url: '300x300' }}" alt="{{ block.settings.role | strip_html | escape }}" loading="lazy">
                </div>
              {% endif %}
              <div class="testimonial-content">
                <h3>{{ block.settings.testimonial_head }}</h3>
                <div class="testimonial-quote" style="color: {{ section.settings.highlight_color }};">
                  {{ block.settings.quote }}
                </div>
                <p class="testimonial-role">{{ block.settings.role }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="testimonial-buttons">
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </div>
  </div>
</section>

<style>
.testimonial-slider {
  padding: 44px 20px;
}
.testimonial-container {
  max-width: 75%;
  margin: 0 auto;
}
.testimonial-inner {
  display: flex;
  align-items: center;
  gap: 34px;
  padding: 38px 42px;
  border-radius: 20px;
  box-shadow: 0 10px 34px rgba(0,64,76,.10);
}
.testimonial-avatar {
  flex-shrink: 0;
}
.testimonial-avatar img {
  width: 128px;
  height: 128px;
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid #ffffff;
  box-shadow: 0 4px 14px rgba(0,0,0,.14);
  display: block;
}
.testimonial-content {
  flex: 1;
  min-width: 0;
}
.testimonial-content h3 {
  font-size: 20px;
  margin: 0 0 10px;
  line-height: 1.3;
}
.testimonial-quote {
  font-size: 17px;
  line-height: 1.65;
}
.testimonial-quote p {
  margin: 0;
}
.testimonial-role {
  margin: 14px 0 0;
  font-weight: 600;
  font-size: 14.5px;
}
.testimonial-buttons {
  display: flex;
  justify-content: center;
  margin-top: 22px;
}
.swiper-button-prev,
.swiper-button-next {
  position: static;
  margin: 0 10px;
  background: #fff;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.swiper-button-prev::after,
.swiper-button-next::after {
  font-size: 16px;
  color: #000;
}
@media (max-width: 768px) {
  .testimonial-inner {
    flex-direction: column;
    text-align: center;
    padding: 32px 24px;
    gap: 18px;
  }
  .testimonial-avatar img {
    width: 104px;
    height: 104px;
  }
  .testimonial-quote {
    font-size: 15px;
  }
  .testimonial-container {
    max-width: 100%;
  }
}
</style>

<!-- Swiper CSS -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
/>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.testimonialSwiper', {
      loop: false,
      autoplay: {
        delay: 10000,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      slidesPerView: 1,
      spaceBetween: 30,
      speed: 700,
      grabCursor: true,
    });
  });
</script>

{% schema %}
{
  "name": "Testimonial Slider",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#00b588"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Client photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Client name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Client role",
          "default": "Canadian Reseller Partner"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Testimonial text",
          "default": "<p>Ink Quest delivers every time—authentic products, fast delivery, and exceptional service.</p>"
        },
        {
          "type": "richtext",
          "id": "testimonial_head",
          "label": "Testimonial text",
          "default": "<p>Ink Quest delivers every time—authentic products, fast delivery, and exceptional service.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Slider",
      "category": "Testimonials"
    }
  ]
}
{% endschema %}

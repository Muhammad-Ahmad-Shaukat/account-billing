{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">


<div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note" style="white-space: nowrap; font-size: 0.9em;">{% if request.locale.iso_code == 'fr' %}Numéro de bon de commande / Notes sur la commande{% else %}Purchase Order Number / Order Notes{% endif %}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
{% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            
{%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

  
                

                <small class="tax-note caption-large rte">
                  {% comment %} {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%} {% endcomment %}
<p>
  <input
    type="checkbox"
    id="shipping_agree"
    name="attributes[Shipping Charges Accepted]"
    value="Yes"
  >
  <label for="shipping_agree">
    {% if request.locale.iso_code == 'fr' %}Je comprends que les frais d'expédition ne sont pas inclus à la caisse. Veuillez également vous assurer que toutes les parties de l'adresse de livraison sont exactes, car des frais de 15 $ par boîte seront facturés si le transporteur doit apporter une correction à l'adresse.{% else %}I understand that shipping charges are not included at checkout. Please also ensure that all parts of the shipping address are correct, as a $15 fee will be charged per box if the carrier needs to make an address correction.{% endif %}
  </label>
</p>

<p>
  <input
  type="checkbox"
  id="dropship"
  name="attributes[Dropship Order]"
  value="Yes"
  form="cart"
>
  <label for="dropship">{% if request.locale.iso_code == 'fr' %}LIVRAISON DIRECTE{% else %}Dropship this Order{% endif %}</label>
</p>
                </small>
              </div>
      
            {%- else -%}
                <div class="cart__ctas" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
            
              </div>

              

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  console.info('[SAP theme checkout] validation loaded v3');

  // SAP checkout must wait for this theme's shipping/Dropship validation.
  const cartForm = document.getElementById('cart');
  if (cartForm) cartForm.dataset.sapCheckoutValidation = 'true';

  const dropship = document.getElementById('dropship');
  const shipping = document.getElementById('shipping_agree');

  let processing = false;

  // Save Dropship attribute in Shopify cart
  async function saveDropship() {
    try {
      const response = await fetch(
        window.Shopify.routes.root + 'cart/update.js',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            attributes: {
              'Dropship Order': dropship && dropship.checked ? 'Yes' : ''
            }
          })
        }
      );

      if (!response.ok) throw new Error('Cart update failed');
      return true;

    } catch (error) {
      console.error(error);
      return false;
    }
  }

  // Save attribute whenever Dropship checkbox changes
  if (dropship) {
    dropship.addEventListener('change', async function () {
      dropship.disabled = true;
      const saved = await saveDropship();
      dropship.disabled = false;

      if (!saved) {
        alert('Unable to save Dropship selection. Please try again.');
      }
    });
  }

  // Common checkout validation
  async function handleCheckout(event, button) {

    console.info('[SAP theme checkout] validation started', { type: event.type, shippingAccepted: !shipping || shipping.checked });


    event.preventDefault();
    event.stopImmediatePropagation();

    if (processing) return;

    // Shipping checkbox is mandatory
    if (shipping && !shipping.checked) {
      shipping.focus();
      alert('Please accept the shipping charges acknowledgement before proceeding to checkout.');
      return;
    }

    processing = true;

    const saved = await saveDropship();

    if (!saved) {
      processing = false;
      alert('Unable to save cart details. Please try again.');
      return;
    }

    const form = document.getElementById('cart');

    if (!form) {
      processing = false;
      alert('Cart form not found.');
      return;
    }

    // Call pricing explicitly: native requestSubmit can bypass an app embed
    // that is missing, outdated, or listening only for clicks.
    if (window.SAPCheckout && typeof window.SAPCheckout.start === 'function') {
      console.info('[SAP theme checkout] validation passed; preparing customer pricing');
      try {
        await window.SAPCheckout.start();
      } finally {
        processing = false;
      }
      return;
    }

    console.error('[SAP theme checkout] sap-checkout.js is missing; checkout stopped to protect customer pricing');
    processing = false;
    alert('Customer pricing could not load. Please refresh the page and try again.');
    return;

  }

  // Checkout button click validation
  document.addEventListener('click', function (event) {

    const button = event.target.closest(
      '#checkout, button[name="checkout"], input[name="checkout"]'
    );

    if (!button) return;

    handleCheckout(event, button);

  }, true);

  // Form submission validation
  document.addEventListener('submit', function (event) {

    if (event.target.id !== 'cart') return;

    handleCheckout(event, event.submitter);

  }, true);

});
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

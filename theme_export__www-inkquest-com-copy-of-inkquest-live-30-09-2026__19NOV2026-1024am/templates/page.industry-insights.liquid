function openArticle(key){
  var a=ARTICLES[key]; if(!a) return;
  document.getElementById('readerTag').textContent=a.tag;
  document.getElementById('readerTitle').textContent=a.title;
  document.getElementById('readerMeta').textContent=a.meta+" • Industry Insights — Ink Quest";
  document.getElementById('readerBody').innerHTML=a.body;
  var d=document.getElementById('reader'); if(typeof d.showModal==='function'){d.showModal();} else {d.setAttribute('open','');}
}
// Filtering
var pills=document.querySelectorAll('.pill');
function applyFilters(){
  var active=document.querySelector('.pill.active').dataset.filter;
  var q=document.getElementById('searchInput').value.trim().toLowerCase();
  var visible=0;
  document.querySelectorAll('.article').forEach(function(el){
    var catOk=(active==='all'||el.dataset.cat===active);
    var qOk=(!q|| (el.textContent.toLowerCase().includes(q) || (el.dataset.search||'').includes(q)));
    var show=catOk&&qOk;
    // In home mode, only-full cards stay hidden regardless — CSS handles it, but count only visible in DOM flow
    el.style.display=show?'':'none';
    if(show) visible++;
  });
  document.getElementById('emptyState').style.display=visible===0?'block':'none';
}
pills.forEach(function(p){p.addEventListener('click',function(){pills.forEach(function(x){x.classList.remove('active')});p.classList.add('active'); applyFilters();});});
document.getElementById('searchInput').addEventListener('input',function(){ applyFilters(); });
// Calculator
function calc(){
  var pA=parseFloat(document.getElementById('priceA').value)||0, yA=parseFloat(document.getElementById('yieldA').value)||1;
  var pB=parseFloat(document.getElementById('priceB').value)||0, yB=parseFloat(document.getElementById('yieldB').value)||1;
  var a=pA/yA*100, b=pB/yB*100;
  document.getElementById('cppA').textContent=a.toFixed(2)+'¢ / page';
  document.getElementById('cppB').textContent=b.toFixed(2)+'¢ / page';
  var cheaper = a<b ? 'A' : 'B'; var diff = Math.abs(a-b)/Math.max(a,b)*100;
  document.getElementById('cppA').style.color = cheaper==='A' ? 'var(--green)' : 'var(--ink)';
  document.getElementById('cppB').style.color = cheaper==='B' ? 'var(--green)' : 'var(--ink)';
  document.getElementById('calcNote').textContent='Cartridge '+cheaper+' is '+diff.toFixed(0)+'% cheaper per page in this comparison. Yields should be the manufacturer’s stated yield for the exact model.';
}
['priceA','yieldA','priceB','yieldB'].forEach(function(id){document.getElementById(id).addEventListener('input',calc);});
calc();

</script>

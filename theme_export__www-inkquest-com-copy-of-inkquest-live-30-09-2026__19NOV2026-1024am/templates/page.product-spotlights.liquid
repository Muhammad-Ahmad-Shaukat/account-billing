      var query = "";

      function badgesHTML(p) {
        var h = '<span class="badge">' + p.brand + '</span><span class="badge">' + p.type.split(",")[0] + '</span>';
        if (p.hot) h += '<span class="badge hot">' + p.hot + '</span>';
        return h;
      }
      function specsHTML(p) {
        return '<span>Yield <strong>' + p.yield + '</strong></span>' +
               '<span>Colour <strong>' + p.color + '</strong></span>' +
               '<span>Model <strong>' + p.model + '</strong></span>';
      }
      function cardHTML(p, featured) {
        var why = "";
        if (featured) {
          why = '<ul class="why-list">' + p.why.map(function (w) { return "<li>" + w + "</li>"; }).join("") + "</ul>";
        }
        return '<article class="card' + (featured ? " featured" : "") + '">' +
          '<div class="photo"><img src="' + p.img + '" alt="' + p.alt + '" loading="lazy" /></div>' +
          '<div class="card-body">' +
            '<div class="badges">' + badgesHTML(p) + '</div>' +
            "<h3>" + p.name + "</h3>" +
            '<p class="tagline">' + p.tagline + "</p>" +
            why +
            '<div class="specs">' + specsHTML(p) + "</div>" +
            '<button type="button" class="open-btn" data-open="' + p.id + '">View spotlight</button>' +
          "</div></article>";
      }

      
      function renderFilters() {
        var box = document.getElementById("brand-filters");
        var pills = BRANDS.map(function (b) {
          return '<button type="button" class="pill" data-brand="' + b + '" aria-pressed="' + (b === activeBrand) + '">' + b + "</button>";
        }).join("");
        box.innerHTML = pills +
          '<label class="search-box"><span aria-hidden="true">⌕</span>' +
          '<input type="search" id="spot-search" placeholder="Search model, brand, or printer…" value="' + query.replace(/"/g, "&quot;") + '" /></label>';
        var input = document.getElementById("spot-search");
        input.addEventListener("input", function () {
          query = input.value;
          renderFull();
          var again = document.getElementById("spot-search");
          again.focus();
          again.setSelectionRange(again.value.length, again.value.length);
        });
      }

      function renderFull() {
        var q = query.trim().toLowerCase();
        var list = PRODUCTS.filter(function (p) {
          if (activeBrand !== "All" && p.brand !== activeBrand) return false;
          if (!q) return true;
          var hay = (p.brand + " " + p.name + " " + p.model + " " + p.printers + " " + p.type).toLowerCase();
          return hay.indexOf(q) !== -1;
        });
        document.getElementById("full-grid").innerHTML =
          list.map(function (p) { return cardHTML(p, false); }).join("");
        document.getElementById("no-results").classList.toggle("hidden", list.length > 0);
      }

      
      function openSpotlight(id) {
        var p = null;
        for (var i = 0; i < PRODUCTS.length; i++) if (PRODUCTS[i].id === id) p = PRODUCTS[i];
        if (!p) return;
        document.getElementById("sheet-img").src = p.img;
        document.getElementById("sheet-img").alt = p.alt;
        document.getElementById("sheet-badges").innerHTML = badgesHTML(p);
        document.getElementById("sheet-title").textContent = p.name;
        document.getElementById("sheet-tagline").textContent = p.tagline;
        document.getElementById("sheet-specs").innerHTML =
          "<tr><th>Model</th><td>" + p.model + "</td></tr>" +
          "<tr><th>Page yield</th><td>" + p.yield + "</td></tr>" +
          "<tr><th>Colour</th><td>" + p.color + "</td></tr>" +
          "<tr><th>Type</th><td>" + p.type + "</td></tr>" +
          "<tr><th>Works with</th><td>" + p.printers + "</td></tr>";
        document.getElementById("sheet-why").innerHTML =
          '<ul class="why-list">' + p.why.map(function (w) { return "<li>" + w + "</li>"; }).join("") + "</ul>";
        document.getElementById("sheet-angle").textContent = p.angle;
        document.getElementById("sheet-variants").innerHTML =
          p.variants.map(function (v) { return "<span>" + v + "</span>"; }).join("");
        document.getElementById("overlay").classList.add("open");
        document.body.style.overflow = "hidden";
        document.getElementById("sheet-close").focus();
      }
      function closeSpotlight() {
        document.getElementById("overlay").classList.remove("open");
        document.body.style.overflow = "";
      }

      
      
      
      document.getElementById("sheet-close").addEventListener("click", closeSpotlight);
      document.getElementById("overlay").addEventListener("click", function (e) {
        if (e.target === this) closeSpotlight();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeSpotlight();
      });
      document.addEventListener("click", function (e) {
        var btn = e.target.closest ? e.target.closest("[data-open]") : null;
        if (btn) openSpotlight(btn.getAttribute("data-open"));
      });
      document.getElementById("brand-filters").addEventListener("click", function (e) {
        var btn = e.target.closest ? e.target.closest("[data-brand]") : null;
        if (!btn) return;
        activeBrand = btn.getAttribute("data-brand");
        renderFilters();
        renderFull();
      });

      
      renderFilters();
      renderFull();
      document.getElementById("overlay").classList.remove("open");
    
</script>

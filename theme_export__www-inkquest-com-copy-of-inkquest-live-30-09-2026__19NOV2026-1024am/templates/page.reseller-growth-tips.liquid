function openArticle(key){
  var a=ARTICLES[key]; if(!a) return;
  document.getElementById('readerTag').textContent=a.tag;
  document.getElementById('readerTitle').textContent=a.title;
  document.getElementById('readerMeta').textContent=a.meta+" • Reseller Growth Tips — Ink Quest";
  document.getElementById('readerBody').innerHTML=a.body;
  var d=document.getElementById('reader'); if(typeof d.showModal==='function'){d.showModal();} else {d.setAttribute('open','');}
}

// Filtering
var pills=document.querySelectorAll('.pill');
function applyFilters(){
  var active=document.querySelector('.pill.active').dataset.filter;
  var q=document.getElementById('searchInput').value.trim().toLowerCase();
  var visible=0;
  document.querySelectorAll('.article').forEach(function(el){
    var catOk=(active==='all'||el.dataset.cat===active);
    var qOk=(!q|| (el.textContent.toLowerCase().includes(q) || (el.dataset.search||'').includes(q)));
    var show=catOk&&qOk;
    el.style.display=show?'':'none';
    if(show) visible++;
  });
  document.getElementById('emptyState').style.display=visible===0?'block':'none';
}
pills.forEach(function(p){p.addEventListener('click',function(){pills.forEach(function(x){x.classList.remove('active')});p.classList.add('active');  applyFilters();});});
document.getElementById('searchInput').addEventListener('input',function(){  applyFilters(); });
// Recurring revenue estimator
function money(n){ return '$'+Math.round(n).toLocaleString('en-CA'); }
function estimate(){
  var acc=parseFloat(document.getElementById('accounts').value)||0;
  var ord=parseFloat(document.getElementById('ordersPer').value)||0;
  var val=parseFloat(document.getElementById('orderValue').value)||0;
  var pct=Math.min(100,Math.max(0,parseFloat(document.getElementById('autoPct').value)||0));
  var monthly=acc*ord*val;
  var secured=monthly*pct/100;
  document.getElementById('revOut').textContent=money(monthly);
  document.getElementById('autoOut').textContent=money(secured)+' / mo';
  document.getElementById('calcNote').textContent='At '+pct+'% on auto-replenishment, '+money(secured)+' of your estimated '+money(monthly)+' monthly revenue arrives whether or not the customer remembers to call. Raise the share of accounts on the programme and the secured number grows — that’s the featured guide above, in numbers. Estimates only — use your own account averages.';
}
['accounts','ordersPer','orderValue','autoPct'].forEach(function(id){document.getElementById(id).addEventListener('input',estimate);});
estimate();

</div>
<script>
(function() {
  var locked = document.querySelector('.mobile-search[data-search-locked]');
  if (!locked) return;
  var popup = document.getElementById('pfx-login-popup');
  var hideTimer;
  // Block form submit
  var form = locked.querySelector('form');
  if (form) form.addEventListener('submit', function(e) { e.preventDefault(); showPopup(); });
  // Show popup on tap
  locked.addEventListener('click', function(e) { e.preventDefault(); showPopup(); });
  function showPopup() {
    popup.classList.add('show');
    clearTimeout(hideTimer);
    hideTimer = setTimeout(function() { popup.classList.remove('show'); }, 2800);
  }
})();
</script>

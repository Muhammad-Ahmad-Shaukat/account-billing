.pfx-login-required-popup a { color: #d9a441; font-weight: 700; text-decoration: underline; }
.mobile-search[data-search-locked] .mobile-search-box { cursor: pointer; }
.mobile-search[data-search-locked] input { pointer-events: none; }

</style>

    flex-shrink:0;
}

.pfx-login-text{
    flex:1;
    font-size:14px;
    color:#777;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.pfx-login-arrow{
    color:#00404c;
    font-size:18px;
    font-weight:600;
    margin-left:10px;
    flex-shrink:0;
}

/* Mobile */
.mobile-search{
    display:none;
}

@media(max-width:991px){

.mobile-search{
    display:block !important;
}
}
/* mobile search input */
.mobile-search{
 background: rgb(255 255 255 / 62%);
 box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;

}
/* search */
.mobile-search{
  width:100%;
}

.mobile-search-box{
  display:flex;
  align-items:center;
  width:100%;
  height:42px;
  background:transparent;
  border:2px solid #00404c;
  border-radius:14px;
  padding:0 16px;
  box-sizing:border-box;
  transition:all .25s ease;
  box-shadow:0 2px 12px rgba(0,64,76,.08);
}

.mobile-search-box:focus-within{
 
  box-shadow:0 0 0 3px rgba(0,64,76,.08);
}

.mobile-search-icon{
  width:22px;
  height:22px;
  flex-shrink:0;
  color:#00404c;
  margin-right:12px;
}

.mobile-search .pfx-search-input{
  flex:1;
  width:100%;
  height:100%;
  border:0 !important;
  outline:none !important;
  background:transparent !important;
  box-shadow:none !important;
  padding:0 !important;
  font-size:14px;
  color:#123f48;
}

.mobile-search .pfx-search-input::placeholder{
  color:#6b7477;
  opacity:1;
  font-size:13px;
}

@media(min-width:992px){
  .mobile-search{
    display:none !important;
  }
}
@media (max-width: 991px) {
  .pfx-mobile-trigger-bar {
    justify-content: flex-start !important;
    gap: 12px;
  }

  .pfx-mobile-trigger-bar .pfx-logo-link {
    margin-left: 0;
    justify-content: flex-start;
  }

  .pfx-mobile-trigger-bar .pfx-actions {
    margin-left: auto;
  }
}

.pfx-price-loader {
  display: inline-block;
  width: 45px;
  height: 12px;
  border-radius: 4px;
  background: linear-gradient(
    90deg,
    #eeeeee 25%,
    #dddddd 50%,
    #eeeeee 75%
  );
  background-size: 200% 100%;
  animation: pfx-price-loading 1.2s infinite;
}

@keyframes pfx-price-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.pfx-search-form{
      border: 1px solid rgb(119, 119, 119, 0.3);
}
/* =========================================
   PREMIUM MOBILE LANGUAGE SWITCHER
========================================= */

#lang-switcher-mobile {
  margin-top: 18px;
  padding: 16px 0 4px;
  border-top: 1px solid rgba(0, 0, 0, 0.07);
}

#lang-switcher-mobile form {
  width: 100%;
}

/* Label */
#lang-switcher-mobile .pfx-mobile-lang-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 9px;
  color: #00404c;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

/* Globe icon before Language */
#lang-switcher-mobile .pfx-mobile-lang-label::before {
  content: "🌐";
  font-size: 14px;
  line-height: 1;
}

/* Select wrapper look */
#lang-switcher-mobile .pfx-mobile-lang-select {
  width: 100%;
  height: 46px;
  padding: 0 42px 0 15px;
  border: 1px solid rgba(0, 64, 76, 0.12);
  border-radius: 12px;
  background: linear-gradient(
    135deg,
    #ffffff 0%,
    #f8fafb 100%
  );
  color: #123f48;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  outline: none;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;

  /* Premium shadow */
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.03),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

/* Custom dropdown arrow */
#lang-switcher-mobile {
  position: relative;
}

#lang-switcher-mobile::after {
  content: "";
  position: absolute;
  right: 16px;
  bottom: 20px;
  width: 7px;
  height: 7px;
  border-right: 1.5px solid #00404c;
  border-bottom: 1.5px solid #00404c;
  transform: rotate(45deg);
  pointer-events: none;
}

/* Hover */
#lang-switcher-mobile .pfx-mobile-lang-select:hover {
  border-color: rgba(0, 64, 76, 0.25);
  background: #ffffff;
}

/* Focus */
#lang-switcher-mobile .pfx-mobile-lang-select:focus {
  border-color: #00404c;
  box-shadow:
    0 0 0 3px rgba(0, 64, 76, 0.08),
    0 4px 12px rgba(0, 0, 0, 0.04);
}

/* Mobile only */
@media (min-width: 992px) {
  #lang-switcher-mobile {
    display: none !important;
  }
}
@media (min-width: 992px) {
  .pfx-top-row .pfx-logo-area {
    transform: translateY(8px);
  }
}

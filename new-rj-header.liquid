{%- comment -%} JavaScript Controller Logic {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const header = document.querySelector('[data-premium-header]');
    
    // --- Sticky Scroll Engine Logic ---
    {% if section.settings.enable_sticky %}
      window.addEventListener('scroll', () => {
        if (window.scrollY > 120) {
          header.classList.add('pfx-sticky-active');
          if(header.classList.contains('pfx-transparent')) {
            header.classList.remove('pfx-transparent');
          }
        } else {
          header.classList.remove('pfx-sticky-active');
          {% if section.settings.enable_transparent and template.name == 'index' %}
            header.classList.add('pfx-transparent');
          {% endif %}
        }
      }, { passive: true });
    {% endif %}

    // --- Mobile Drawer Component Handler ---
    const drawerTrigger = document.querySelector('[data-pfx-drawer-trigger]');
    const drawerClose = document.querySelector('[data-pfx-drawer-close]');
    const drawerOverlay = document.querySelector('[data-pfx-drawer-overlay]');
    const drawer = document.querySelector('[data-pfx-drawer]');

    if(drawerTrigger && drawer) {
      drawerTrigger.addEventListener('click', () => {
        drawer.classList.add('pfx-drawer-open');
        drawerOverlay.classList.add('pfx-overlay-active');
        document.body.style.overflow = 'hidden';
      });
    }

    const closeMenuFunc = () => {
      if(drawer) drawer.classList.remove('pfx-drawer-open');
      if(drawerOverlay) drawerOverlay.classList.remove('pfx-overlay-active');
      document.body.style.overflow = '';
    };

    if(drawerClose) drawerClose.addEventListener('click', closeMenuFunc);
    if(drawerOverlay) drawerOverlay.addEventListener('click', closeMenuFunc);

    const accordionTriggers = document.querySelectorAll('[data-pfx-accordion-trigger]');
    accordionTriggers.forEach(btn => {
      btn.addEventListener('click', () => {
        const submenu = btn.nextElementSibling;
        if(submenu) {
          submenu.classList.toggle('pfx-open');
          const icon = btn.querySelector('svg');
          if(icon) {
            icon.style.transform = submenu.classList.contains('pfx-open') ? 'rotate(180deg)' : 'rotate(0deg)';
          }
        }
      });
    });

    // --- Mobile Fullscreen Search Overlay ---
    const searchTrigger = document.querySelector('[data-pfx-search-overlay-trigger]');
    const searchClose = document.querySelector('[data-pfx-search-overlay-close]');
    const searchOverlay = document.querySelector('[data-pfx-search-overlay]');

    if(searchTrigger && searchOverlay) {
      searchTrigger.addEventListener('click', () => {
        searchOverlay.classList.add('pfx-overlay-open');
        const mInput = searchOverlay.querySelector('input[type="text"]');
        if(mInput) setTimeout(() => mInput.focus(), 150);
      });
    }
    if(searchClose && searchOverlay) {
      searchClose.addEventListener('click', () => {
        searchOverlay.classList.remove('pfx-overlay-open');
      });
    }

    // --- Option D: mobile search icon toggles the mobile search bar ---
    const mobileSearchToggle = document.querySelector('[data-pfx-mobile-search-toggle]');
    const mobileSearchBar = document.querySelector('.pfx-search-container.mobile-search');
    if(mobileSearchToggle && mobileSearchBar) {
      mobileSearchToggle.addEventListener('click', () => {
        const open = mobileSearchBar.classList.toggle('pfx-mobile-search-open');
        mobileSearchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if(open) {
          const mInput = mobileSearchBar.querySelector('input[type="text"]');
          if(mInput) setTimeout(() => mInput.focus(), 50);
        }
      });
    }

    // --- Safe & Verified Shopify Predictive Search Engine ---
    {% if section.settings.enable_predictive_search and customer %}
      const PFX_PRICE_API = 'https://ratandeep-sap-client.onrender.com/apps/sap-price-test';
      const PFX_CUSTOMER_ID = {{ customer.id | json }};
      const PFX_SHOP_DOMAIN = {{ shop.permanent_domain | json }};
      const PFX_CUSTOMER_ADDRESSES = {{ customer.addresses | json }} || [];

      function pfxHasApiPrice(value) {
        if (value === null || value === undefined) return false;
        if (String(value).trim() === '') return false;
        const n = Number(value);
        return Number.isFinite(n) && n > 0;
      }

      function pfxFormatMoney(value) {
        if (value === null || value === undefined || String(value).trim() === '') return '-';
        const n = parseFloat(String(value).replace(/[^0-9.\-]/g, ''));
        if (!Number.isFinite(n)) return String(value);
        if (window.Shopify && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(Math.round(n * 100));
        }
        return '$' + n.toFixed(2);
      }

      function pfxShopifyFallback(shopifyPrice) {
        if (!shopifyPrice || String(shopifyPrice).trim() === '') return '-';
        return pfxFormatMoney(shopifyPrice);
      }

      function pfxGetHandle(prod) {
        if (prod.handle) return prod.handle;
        const match = String(prod.url || '').match(/\/products\/([^/?#]+)/);
        return match ? decodeURIComponent(match[1]) : '';
      }

      function pfxSkuFromProductJson(product, prod) {
        const variants = product.variants || [];
        const variantMatch = String(prod.url || '').match(/[?&]variant=(\d+)/);
        if (variantMatch) {
          const matched = variants.find(function(v) { return String(v.id) === variantMatch[1]; });
          if (matched && matched.sku) return String(matched.sku).trim();
        }
        const withSku = variants.find(function(v) { return v.sku && String(v.sku).trim(); });
        return withSku ? String(withSku.sku).trim() : '';
      }

      async function pfxResolveSku(prod) {
        if (prod.sku) return String(prod.sku).trim();
        if (prod.variants && prod.variants[0] && prod.variants[0].sku) {
          return String(prod.variants[0].sku).trim();
        }
        const handle = pfxGetHandle(prod);
        if (!handle) return '';
        const res = await fetch('/products/' + encodeURIComponent(handle) + '.js');
        if (!res.ok) throw new Error('Product lookup failed');
        const product = await res.json();
        return pfxSkuFromProductJson(product, prod);
      }

      async function pfxFetchApiPrices(skus) {
        if (!skus.length) return {};

        try {
          await fetch(PFX_PRICE_API + '/sapcall', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              data: {
                items: skus.map(function(sku) { return { sku: sku, quantity: 1 }; }),
                customer_id: PFX_CUSTOMER_ID,
                customer_addresses: PFX_CUSTOMER_ADDRESSES,
                shop: PFX_SHOP_DOMAIN
              }
            })
          });
        } catch (error) {
          console.warn('SAP webhook call failed:', error);
        }

        const redisRes = await fetch(PFX_PRICE_API + '/redis-prices', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            customerId: PFX_CUSTOMER_ID,
            skus: skus,
            shop: PFX_SHOP_DOMAIN
          })
        });

        if (!redisRes.ok) throw new Error('Pricing API failed');
        const apiData = await redisRes.json();
        return apiData.prices || {};
      }

      const setupPredictiveSearch = (inputSelector, resultsSelector) => {
        const input = document.querySelector(inputSelector);
        const results = document.querySelector(resultsSelector);
        
        if (!input || !results) return;

        let debounceTimeout;
        
        input.addEventListener('input', () => {
          clearTimeout(debounceTimeout);
          const searchTerm = input.value.trim();

          if (searchTerm.length < 3) {
            results.style.display = 'none';
            results.innerHTML = '';
            return;
          }

          debounceTimeout = setTimeout(() => {
            fetch(`/search/suggest.json?q=${encodeURIComponent(searchTerm)}&resources[type]=product&resources[limit]=5`)
              .then(res => {
                if (!res.ok) throw new Error('API Error');
                return res.json();
              })
              .then(data => {
                const products = data.resources.results.products;
                
                results.innerHTML = '';
                
                if(products && products.length > 0) {
                  const heading = document.createElement('div');
                  heading.style.padding = '12px 16px';
                  heading.style.borderBottom = '1px solid #f0f0f0';
                  heading.style.fontWeight = '700';
                  heading.style.fontSize = '11px';
                  heading.style.color = '#888';
                  heading.style.letterSpacing = '0.5px';
                  heading.innerText = 'PRODUCTS SUGGESTIONS';
                  results.appendChild(heading);

                  const pendingPrices = [];
                  
                  products.forEach(prod => {
                    const itemLink = document.createElement('a');
                    itemLink.href = prod.url;
                    itemLink.style.display = 'flex';
                    itemLink.style.alignItems = 'center';
                    itemLink.style.gap = '14px';
                    itemLink.style.padding = '12px 16px';
                    itemLink.style.textDecoration = 'none';
                    itemLink.style.borderBottom = '1px solid #f9f9f9';
                    itemLink.style.transition = 'background 0.2s';
                    
                    itemLink.addEventListener('mouseover', () => itemLink.style.background = '#f5f5f7');
                    itemLink.addEventListener('mouseout', () => itemLink.style.background = 'transparent');
                    
                    const img = document.createElement('img');
                    img.src = prod.image || 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="%23ccc"><rect width="20" height="20" x="2" y="2" rx="2"/></svg>';
                    img.style.width = '44px';
                    img.style.height = '44px';
                    img.style.objectFit = 'cover';
                    img.style.borderRadius = '6px';
                    img.style.border = '1px solid rgba(0,0,0,0.05)';
                    img.alt = prod.title;
                    
                    const infoDiv = document.createElement('div');
                    infoDiv.style.flex = '1';
                    
                    const titleDiv = document.createElement('div');
                    titleDiv.style.fontSize = '14px';
                    titleDiv.style.color = '#121212';
                    titleDiv.style.fontWeight = '600';
                    titleDiv.style.lineHeight = '1.3';
                    titleDiv.style.display = '-webkit-box';
                    titleDiv.style.webkitLineClamp = '1';
                    titleDiv.style.webkitBoxOrient = 'vertical';
                    titleDiv.style.overflow = 'hidden';
                    titleDiv.innerText = prod.title;
                    
                    const priceDiv = document.createElement('div');
                    priceDiv.style.fontSize = '13px';
                    priceDiv.style.color = '#666';
                    priceDiv.style.marginTop = '3px';
                    priceDiv.style.fontWeight = '500';

                    const shopifyPrice = prod.price || '';
                    priceDiv.innerHTML = '<span class="pfx-price-loader"></span>';
                    pendingPrices.push({ prod: prod, priceDiv: priceDiv, shopifyPrice: shopifyPrice });

                    infoDiv.appendChild(titleDiv);
                    infoDiv.appendChild(priceDiv);
                    itemLink.appendChild(img);
                    itemLink.appendChild(infoDiv);
                    
                    results.appendChild(itemLink);
                  });
                  
                  results.style.display = 'block';

                  Promise.all(pendingPrices.map(function(item) {
                    return pfxResolveSku(item.prod)
                      .then(function(sku) {
                        item.sku = sku || '';
                        return item;
                      })
                      .catch(function() {
                        item.sku = '';
                        return item;
                      });
                  })).then(function(items) {
                    const skus = items.map(function(i) { return i.sku; }).filter(Boolean);
                    return pfxFetchApiPrices(skus).then(function(priceMap) {
                      items.forEach(function(item) {
                        const apiPrice = item.sku ? priceMap[item.sku] : null;
                        if (pfxHasApiPrice(apiPrice)) {
                          item.priceDiv.innerText = pfxFormatMoney(apiPrice);
                        } else {
                          item.priceDiv.innerText = pfxShopifyFallback(item.shopifyPrice);
                        }
                      });
                    });
                  }).catch(function(error) {
                    console.error('Custom pricing API error:', error);
                    pendingPrices.forEach(function(item) {
                      item.priceDiv.innerText = pfxShopifyFallback(item.shopifyPrice);
                    });
                  });
                } else {
                  const noResult = document.createElement('div');
                  noResult.style.padding = '24px 16px';
                  noResult.style.fontSize = '14px';
                  noResult.style.color = '#777';
                  noResult.style.textAlign = 'center';
                  noResult.style.fontWeight = '500';
                  noResult.innerText = 'No items found matches your query';
                  results.appendChild(noResult);
                  results.style.display = 'block';
                }
              })
              .catch(err => {
                console.error('Search Engine Exception:', err);
              });
          }, 250);
        });

        // Close results dropdown on outer click boundaries
        document.addEventListener('click', (e) => {
          if (!input.contains(e.target) && !results.contains(e.target)) {
            results.style.display = 'none';
          }
        });
      };

      // Active registration across layout viewports
      setupPredictiveSearch('[data-pfx-predictive-input]', '[data-pfx-predictive-results]');
      setupPredictiveSearch('[data-pfx-predictive-input-mobile]', '[data-pfx-predictive-results-mobile]');
    {% endif %}
  });
</script>

{% unless customer %}
<script>
(function () {
  var loginUrl = '{{ routes.account_login_url }}{% if routes.account_login_url contains '?' %}&{% else %}?{% endif %}return_to={% if request.locale.iso_code == 'fr' %}/fr{% endif %}/pages/my-account';
  function gateWishlistIcon() {
    var el = document.getElementById('wl-header-icon-root') || document.querySelector('.wl-header-icon-link');
    if (!el || !el.parentNode || el.dataset.iqLoginGated) return;
    var clone = el.cloneNode(true);
    clone.setAttribute('href', loginUrl);
    clone.dataset.iqLoginGated = '1';
    clone.addEventListener('click', function (ev) {
      ev.preventDefault();
      window.location.href = loginUrl;
    });
    el.parentNode.replaceChild(clone, el);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', gateWishlistIcon);
  } else {
    gateWishlistIcon();
  }
  window.addEventListener('load', gateWishlistIcon);
  if (window.MutationObserver && document.body) {
    new MutationObserver(gateWishlistIcon).observe(document.body, { childList: true, subtree: true });
  }
})();
</script>
{% endunless %}
<script>
/* IQ logout flow: back-button guard + sign-out confirmation.
   After a logout, the browser Back button can restore the dashboard from
   its back-forward cache looking still logged in. Flag the logout click;
   on a cached restore of an account page, hide the stale page at once and
   go home. Right after a logout, show a one-time sign-out confirmation
   on the homepage. */
(function () {
  {% if customer %}
  try { sessionStorage.removeItem('iq_logged_out'); sessionStorage.removeItem('iq_just_logged_out'); } catch (e) {}
  {% else %}
  try {
    if (sessionStorage.getItem('iq_just_logged_out') === '1') {
      var _path = window.location.pathname;
      if (_path === '/' || _path === '/fr' || _path === '/fr/') {
        var _toast = document.createElement('div');
        _toast.textContent = "{% if request.locale.iso_code == 'fr' %}Vous avez été déconnecté.{% else %}You have been signed out.{% endif %}";
        _toast.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#00404c;color:#fff;padding:12px 24px;border-radius:999px;font-size:14px;font-weight:500;z-index:9999;box-shadow:0 8px 24px rgba(0,0,0,.2);transition:opacity .5s ease;';
        document.body.appendChild(_toast);
        setTimeout(function () { _toast.style.opacity = '0'; }, 4000);
        setTimeout(function () { if (_toast.parentNode) _toast.parentNode.removeChild(_toast); }, 4600);
      }
      sessionStorage.removeItem('iq_just_logged_out');
    }
  } catch (e) {}
  {% endif %}
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[href*="/account/logout"]') : null;
    if (a) { try { sessionStorage.setItem('iq_logged_out', '1'); sessionStorage.setItem('iq_just_logged_out', '1'); } catch (err) {} }
  });
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    var loggedOut = false;
    try { loggedOut = sessionStorage.getItem('iq_logged_out') === '1'; } catch (err) {}
    if (!loggedOut) return;
    var path = window.location.pathname;
    var isAccountPage = path === '/pages/my-account' || path === '/fr/pages/my-account'
      || path.indexOf('/account') === 0 || path.indexOf('/fr/account') === 0;
    if (isAccountPage) {
      document.documentElement.style.visibility = 'hidden';
      setTimeout(function () { document.documentElement.style.visibility = ''; }, 2000);
      window.location.replace('/');
    }
  });
})();
</script>
